<script>
  (function() {
    const root = document.getElementById('ghTestimonialSection-{{ section.id }}');
    if (!root) return;

    const viewport = root.querySelector('.js-testimonial-viewport');
    const track = root.querySelector('.js-testimonial-track');
    const pagination = root.querySelector('.js-testimonial-pagination');
    if (!viewport || !track) return;

    const slides = track.querySelectorAll('.gh-testimonial-slide');
    if (slides.length === 0) return;

    let currentTranslate = 0;
    let autoplayTimer = null;
    const isAutoplay = {{ autoplay | json }};
    const autoplaySpeed = {{ autoplay_speed }};

    function getStepSize() {
      if (slides.length <= 1) return 0;
      const s0 = slides[0].getBoundingClientRect();
      const s1 = slides[1].getBoundingClientRect();
      return s1.left - s0.left;
    }

    function getMaxTranslate() {
      const totalTrackWidth = track.scrollWidth;
      const viewportWidth = viewport.offsetWidth;
      return Math.max(0, totalTrackWidth - viewportWidth);
    }

    // Build Pagination Dots
    function buildPagination() {
      if (!pagination) return;
      pagination.innerHTML = '';

      const maxTrans = getMaxTranslate();
      const step = getStepSize();
      if (maxTrans <= 5 || step <= 0) {
        pagination.style.display = 'none';
        return;
      }
      pagination.style.display = 'flex';

      const totalDots = Math.max(1, Math.round(maxTrans / step) + 1);

      for (let i = 0; i < totalDots; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'gh-testimonial-dot' + (i === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to review ' + (i + 1));
        const targetPos = (i === totalDots - 1) ? maxTrans : Math.min(i * step, maxTrans);
        dot.addEventListener('click', () => {
          scrollToTranslate(targetPos, true);
          resetAutoplay();
        });
        pagination.appendChild(dot);
      }
    }

    function updateDots() {
      if (!pagination) return;
      const dots = pagination.querySelectorAll('.gh-testimonial-dot');
      if (dots.length === 0) return;

      const maxTrans = getMaxTranslate();
      if (maxTrans <= 0) return;

      let activeIndex = Math.round(currentTranslate / (maxTrans / Math.max(1, dots.length - 1)));
      if (isNaN(activeIndex)) activeIndex = 0;
      activeIndex = Math.max(0, Math.min(activeIndex, dots.length - 1));

      dots.forEach((dot, idx) => {
        if (idx === activeIndex) dot.classList.add('is-active');
        else dot.classList.remove('is-active');
      });
    }

    function setTranslate(val, animated) {
      if (animated) {
        track.style.transition = 'transform 0.4s cubic-bezier(0.25, 1, 0.5, 1)';
      } else {
        track.style.transition = 'none';
      }
      currentTranslate = val;
      track.style.transform = `translate3d(-${val}px, 0px, 0px)`;
    }

    function scrollToTranslate(val, animated = true) {
      const maxTrans = getMaxTranslate();
      const clamped = Math.max(0, Math.min(val, maxTrans));
      setTranslate(clamped, animated);
      updateDots();
    }

    // Autoplay implementation
    function startAutoplay() {
      if (!isAutoplay) return;
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        const step = getStepSize();
        const maxTrans = getMaxTranslate();
        let nextTrans = currentTranslate + step;
        if (nextTrans > maxTrans + 5) {
          nextTrans = 0; // loop back to first
        }
        scrollToTranslate(nextTrans, true);
      }, autoplaySpeed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function resetAutoplay() {
      if (isAutoplay) {
        stopAutoplay();
        startAutoplay();
      }
    }

    // Mouse Drag & Touch Swipe implementation
    let isPointerDown = false;
    let startX = 0;
    let initialTranslate = 0;
    let hasMoved = false;

    function onPointerDown(e) {
      isPointerDown = true;
      hasMoved = false;
      startX = e.pageX || (e.touches && e.touches[0].pageX);
      initialTranslate = currentTranslate;
      stopAutoplay();
      viewport.classList.add('is-dragging');
    }

    function onPointerMove(e) {
      if (!isPointerDown) return;
      const currentX = e.pageX || (e.touches && e.touches[0].pageX);
      const diffX = currentX - startX;

      if (Math.abs(diffX) > 4) {
        hasMoved = true;
      }

      const maxTrans = getMaxTranslate();
      let newTranslate = initialTranslate - diffX;

      // Elastic resistance on edges
      if (newTranslate < 0) {
        newTranslate = newTranslate * 0.35;
      } else if (newTranslate > maxTrans) {
        newTranslate = maxTrans + (newTranslate - maxTrans) * 0.35;
      }

      setTranslate(newTranslate, false);
    }

    function onPointerUp(e) {
      if (!isPointerDown) return;
      isPointerDown = false;
      viewport.classList.remove('is-dragging');

      const currentX = e.pageX || (e.changedTouches && e.changedTouches[0].pageX) || startX;
      const diffX = currentX - startX;
      const step = getStepSize();
      const maxTrans = getMaxTranslate();

      if (Math.abs(diffX) > 45 && step > 0) {
        if (diffX < 0) {
          // dragged left -> advance
          const targetIndex = Math.ceil(initialTranslate / step) + 1;
          scrollToTranslate(targetIndex * step, true);
        } else {
          // dragged right -> retreat
          const targetIndex = Math.floor(initialTranslate / step) - 1;
          scrollToTranslate(Math.max(0, targetIndex * step), true);
        }
      } else if (step > 0) {
        // snap to nearest
        const nearestIndex = Math.round(currentTranslate / step);
        scrollToTranslate(nearestIndex * step, true);
      } else {
        scrollToTranslate(currentTranslate, true);
      }

      resetAutoplay();
    }

    // Attach drag/swipe listeners
    viewport.addEventListener('mousedown', onPointerDown);
    window.addEventListener('mousemove', onPointerMove);
    window.addEventListener('mouseup', onPointerUp);

    viewport.addEventListener('touchstart', onPointerDown, { passive: true });
    viewport.addEventListener('touchmove', onPointerMove, { passive: true });
    viewport.addEventListener('touchend', onPointerUp, { passive: true });

    // Pause on hover
    root.addEventListener('mouseenter', stopAutoplay);
    root.addEventListener('mouseleave', resetAutoplay);

    // Resize handler
    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        buildPagination();
        scrollToTranslate(currentTranslate, false);
      }, 150);
    });

    // Init
    buildPagination();
    startAutoplay();
  })();
</script>

