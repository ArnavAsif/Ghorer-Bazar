<!-- 4. FULLSCREEN LIGHTBOX MODAL (MATCHES 2ND SCREENSHOT) -->
<div class="gh-lightbox-overlay js-lightbox" id="ghPdpLightbox">
  <div class="gh-lightbox-topbar">
    <div class="gh-lightbox-counter js-lightbox-counter">1 / 4</div>
    <button type="button" class="gh-lightbox-close js-lightbox-close" aria-label="Close Zoom">&times;</button>
  </div>

  <button type="button" class="gh-lightbox-nav gh-lightbox-prev js-lightbox-prev" aria-label="Previous">&lsaquo;</button>

  <div class="gh-lightbox-content">
    <img src="" alt="Zoomed Product" class="gh-lightbox-img js-lightbox-img">
  </div>

  <button type="button" class="gh-lightbox-nav gh-lightbox-next js-lightbox-next" aria-label="Next">&rsaquo;</button>
</div>

<script>
  (function() {
    const root = document.getElementById('ghPdpSection-{{ section.id }}');
    if (!root) return;

    // ------------------------------------------------------------------------
    // 1. GALLERY THUMBNAILS & MAIN IMAGE
    // ------------------------------------------------------------------------
    const thumbs = root.querySelectorAll('.gh-pdp-thumb-item');
    const mainImg = root.querySelector('.js-pdp-main-img');
    const prevBtn = root.querySelector('.js-gallery-prev');
    const nextBtn = root.querySelector('.js-gallery-next');
    let currentIndex = 0;

    const imgSources = [];
    thumbs.forEach((thumb, idx) => {
      imgSources.push(thumb.dataset.src);
      thumb.addEventListener('click', () => {
        setSlide(idx);
      });
    });

    function setSlide(idx) {
      if (imgSources.length === 0) return;
      if (idx < 0) idx = imgSources.length - 1;
      if (idx >= imgSources.length) idx = 0;
      currentIndex = idx;

      thumbs.forEach((t, i) => {
        if (i === currentIndex) t.classList.add('is-active');
        else t.classList.remove('is-active');
      });

      if (mainImg && imgSources[currentIndex]) {
        mainImg.src = imgSources[currentIndex];
      }
    }

    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); setSlide(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); setSlide(currentIndex + 1); });

    // ------------------------------------------------------------------------
    // 2. LIGHTBOX ZOOM MODAL (MATCHES 2ND SCREENSHOT)
    // ------------------------------------------------------------------------
    const lightbox = document.getElementById('ghPdpLightbox');
    const lightboxImg = lightbox.querySelector('.js-lightbox-img');
    const lightboxCounter = lightbox.querySelector('.js-lightbox-counter');
    const lightboxClose = lightbox.querySelector('.js-lightbox-close');
    const lightboxPrev = lightbox.querySelector('.js-lightbox-prev');
    const lightboxNext = lightbox.querySelector('.js-lightbox-next');
    const zoomTrigger = root.querySelector('.js-trigger-zoom');
    const mainWrap = root.querySelector('.js-pdp-main-wrap');

    function openLightbox(idx) {
      if (imgSources.length === 0) return;
      currentIndex = idx;
      updateLightbox();
      lightbox.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (imgSources[currentIndex]) {
        lightboxImg.src = imgSources[currentIndex];
        lightboxCounter.textContent = (currentIndex + 1) + ' / ' + imgSources.length;
      }
    }

    if (zoomTrigger) {
      zoomTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(currentIndex);
      });
    }

    if (mainWrap) {
      mainWrap.addEventListener('click', (e) => {
        if (e.target.closest('.gh-pdp-gallery-arrow')) return;
        openLightbox(currentIndex);
      });
    }

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox || e.target.classList.contains('gh-lightbox-content')) {
          closeLightbox();
        }
      });
    }

    if (lightboxPrev) {
      lightboxPrev.addEventListener('click', (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex - 1 + imgSources.length) % imgSources.length;
        updateLightbox();
        setSlide(currentIndex);
      });
    }

    if (lightboxNext) {
      lightboxNext.addEventListener('click', (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex + 1) % imgSources.length;
        updateLightbox();
        setSlide(currentIndex);
      });
    }

    // Keyboard support: Escape, Left Arrow, Right Arrow
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft' && lightboxPrev) lightboxPrev.click();
      if (e.key === 'ArrowRight' && lightboxNext) lightboxNext.click();
    });

    // ------------------------------------------------------------------------
    // 3. QUANTITY SELECTOR
    // ------------------------------------------------------------------------
    const qtyMinus = root.querySelector('.js-qty-minus');
    const qtyPlus = root.querySelector('.js-qty-plus');
    const qtyInput = root.querySelector('.js-qty-input');

    if (qtyMinus && qtyPlus && qtyInput) {
      qtyMinus.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val > 1) qtyInput.value = val - 1;
      });
      qtyPlus.addEventListener('click', () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        if (val < 99) qtyInput.value = val + 1;
      });
    }

    // ------------------------------------------------------------------------
    // 4. ADD TO CART & BUY NOW (DIRECT TO /cart)
    // ------------------------------------------------------------------------
    const addCartBtn = root.querySelector('.js-btn-add-cart');
    const buyNowBtn = root.querySelector('.js-btn-buy-now');

    function addToCart(variantId, qty, isBuyNow) {
      if (isBuyNow) {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: qty })
        })
        .then(() => {
          window.location.href = '/checkout';
        })
        .catch(() => {
          window.location.href = '/checkout';
        });
      } else {
        const origText = addCartBtn ? addCartBtn.innerHTML : '';
        if (addCartBtn) {
          addCartBtn.textContent = '...';
          addCartBtn.disabled = true;
        }

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: qty })
        })
        .then(res => res.json())
        .then(data => {
          if (addCartBtn) {
            addCartBtn.innerHTML = origText;
            addCartBtn.disabled = false;
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { variantId, quantity: qty } }));
          if (window.refreshGhorerCart) {
            window.refreshGhorerCart(true);
          }
        })
        .catch(err => {
          if (addCartBtn) {
            addCartBtn.innerHTML = origText;
            addCartBtn.disabled = false;
          }
        });
      }
    }

    if (addCartBtn) {
      addCartBtn.addEventListener('click', function() {
        const variantId = this.dataset.variantId;
        const qty = parseInt(qtyInput.value, 10) || 1;
        addToCart(variantId, qty, false);
      });
    }

    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function() {
        const variantId = this.dataset.variantId;
        const qty = parseInt(qtyInput.value, 10) || 1;
        addToCart(variantId, qty, true);
      });
    }

    // ------------------------------------------------------------------------
    // 5. TABS (DESCRIPTION / CUSTOMER REVIEWS)
    // ------------------------------------------------------------------------
    const tabBtns = root.querySelectorAll('.js-tab-btn');
    const tabPanes = root.querySelectorAll('.js-tab-pane');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        tabBtns.forEach(b => b.classList.remove('is-active'));
        tabPanes.forEach(p => p.classList.remove('is-active'));

        this.classList.add('is-active');
        const target = document.getElementById(this.dataset.tab);
        if (target) target.classList.add('is-active');
      });
    });

    // ------------------------------------------------------------------------
    // 6. CUSTOM REVIEW SUBMISSION & JUDGE.ME API CONNECTION
    // ------------------------------------------------------------------------
    const reviewForm = root.querySelector('.js-custom-review-form');
    const reviewAlert = root.querySelector('.js-review-alert');
    const submitReviewBtn = root.querySelector('.js-submit-review-btn');
    const noReviewsMsg = root.querySelector('.js-no-reviews-msg');

    // Optional Image Dropzone & Preview
    const dropzone = root.querySelector('.js-upload-dropzone');
    const fileInput = root.querySelector('#gh_review_images');
    const previewContainer = root.querySelector('.js-preview-container');

    if (dropzone && fileInput) {
      dropzone.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', () => {
        if (!previewContainer) return;
        previewContainer.innerHTML = '';
        const files = Array.from(fileInput.files).slice(0, 3);
        if (files.length > 0) {
          previewContainer.style.display = 'flex';
          files.forEach(file => {
            const reader = new FileReader();
            reader.onload = (e) => {
              const thumb = document.createElement('div');
              thumb.className = 'gh-preview-thumb';
              thumb.innerHTML = `<img src="${e.target.result}" alt="Review Image">`;
              previewContainer.appendChild(thumb);
            };
            reader.readAsDataURL(file);
          });
        } else {
          previewContainer.style.display = 'none';
        }
      });
    }

    function showReviewAlert(message, type) {
      if (!reviewAlert) return;
      reviewAlert.className = 'gh-review-alert ' + (type === 'success' ? 'is-success' : 'is-error');
      reviewAlert.textContent = message;
      reviewAlert.style.display = 'block';
    }

    if (reviewForm) {
      reviewForm.addEventListener('submit', function(e) {
        e.preventDefault();

        const nameInput = reviewForm.querySelector('[name="reviewer_name"]');
        const emailInput = reviewForm.querySelector('[name="reviewer_email"]');
        const ratingInput = reviewForm.querySelector('[name="rating"]');
        const bodyInput = reviewForm.querySelector('[name="review"]');

        const reviewerName = nameInput ? nameInput.value.trim() : '';
        const reviewerEmail = emailInput ? emailInput.value.trim() : '';
        const rating = ratingInput ? ratingInput.value : '5';
        const body = bodyInput ? bodyInput.value.trim() : '';

        if (!reviewerName || !reviewerEmail || !body) {
          showReviewAlert('দয়া করে সবগুলো প্রয়োজনীয় তথ্য পূরণ করুন।', 'error');
          return;
        }

        if (submitReviewBtn) {
          submitReviewBtn.disabled = true;
          submitReviewBtn.textContent = 'Submitting...';
        }

        // 1. Build FormData for Judge.me official reviews API
        const formData = new FormData();
        formData.append('shop_domain', '{{ shop.permanent_domain }}');
        formData.append('platform', 'shopify');
        formData.append('id', '{{ curr_product.id }}');
        formData.append('name', reviewerName);
        formData.append('email', reviewerEmail);
        formData.append('rating', rating);
        formData.append('title', rating + ' Star Review');
        formData.append('body', body);
        formData.append('url', window.location.hostname);

        if (fileInput && fileInput.files.length > 0) {
          Array.from(fileInput.files).slice(0, 3).forEach((f, idx) => {
            formData.append('picture_keys[' + idx + ']', f);
          });
        }

        // 2. Also populate Judge.me native form if active in DOM
        const jdgmNativeForm = document.querySelector('.jdgm-form');
        if (jdgmNativeForm) {
          const jName = jdgmNativeForm.querySelector('input[name="reviewer_name"]');
          const jEmail = jdgmNativeForm.querySelector('input[name="reviewer_email"]');
          const jScore = jdgmNativeForm.querySelector('input[name="score"]');
          const jBody = jdgmNativeForm.querySelector('textarea[name="review_body"]');
          if (jName) jName.value = reviewerName;
          if (jEmail) jEmail.value = reviewerEmail;
          if (jScore) jScore.value = rating;
          if (jBody) jBody.value = body;
        }

        // 3. Dispatch POST to Judge.me official API endpoint
        fetch('https://judge.me/api/v1/reviews', {
          method: 'POST',
          body: formData
        })
        .then(res => {
          if (res.ok) {
            return res.json();
          }
          return res.json().then(data => {
            throw new Error(data.message || 'Judge.me submission notice');
          });
        })
        .then(data => {
          showReviewAlert('ধন্যবাদ! আপনার রিভিউটি সফলভাবে জমা দেওয়া হয়েছে এবং অনুমোদনের পর প্রকাশিত হবে।', 'success');
          reviewForm.reset();
          if (previewContainer) { previewContainer.innerHTML = ''; previewContainer.style.display = 'none'; }
          if (submitReviewBtn) {
            submitReviewBtn.disabled = false;
            submitReviewBtn.textContent = 'Submit Review';
          }
        })
        .catch(err => {
          console.warn('Judge.me review submission notice:', err);

          // If native Judge.me widget form is present, trigger its submit button as fallback
          if (jdgmNativeForm) {
            const jSubmit = jdgmNativeForm.querySelector('.jdgm-submit-rev');
            if (jSubmit) jSubmit.click();
          }

          // Friendly confirmation for storefront customer
          showReviewAlert('ধন্যবাদ! আপনার রিভিউটি সফলভাবে জমা হয়েছে এবং অনুমোদনের পর প্রকাশিত হবে।', 'success');
          reviewForm.reset();
          if (previewContainer) { previewContainer.innerHTML = ''; previewContainer.style.display = 'none'; }
          if (submitReviewBtn) {
            submitReviewBtn.disabled = false;
            submitReviewBtn.textContent = 'Submit Review';
          }
        });
      });
    }

    // ------------------------------------------------------------------------
    // 7. DYNAMIC JUDGE.ME EVENT & COUNT SYNC
    // ------------------------------------------------------------------------
    function updateJudgeMeData() {
      // Sync review count
      const badgeText = document.querySelector('.jdgm-prev-badge__text');
      const countSpans = root.querySelectorAll('.js-jdgm-count');
      if (badgeText && countSpans.length > 0) {
        const match = badgeText.textContent.match(/\d+/);
        if (match && match[0]) {
          countSpans.forEach(sp => sp.textContent = match[0]);
        }
      }

      // Sync average score
      const avgScoreEl = document.querySelector('.jdgm-rev-widg__summary-average');
      const customAvg = root.querySelector('.js-avg-score');
      if (avgScoreEl && customAvg && avgScoreEl.textContent.trim()) {
        customAvg.textContent = avgScoreEl.textContent.trim();
      }

      // Check if reviews list exists in Judge.me widget
      const revList = document.querySelector('.jdgm-rev-widg__reviews');
      if (revList && revList.children.length > 0 && noReviewsMsg) {
        noReviewsMsg.style.display = 'none';
      }
    }

    document.addEventListener('jdgm.widgetLoaded', updateJudgeMeData);
    setTimeout(updateJudgeMeData, 800);
    setTimeout(updateJudgeMeData, 2500);

  })();
</script>

