{% comment %}
  =============================================================================
  SHOPIFY MAIN PRODUCT DETAILS SECTION (100% DYNAMIC)
  - File: sections/custom-main-product.liquid
  - Product Description: Strictly from product.description (NO static text)
  - Reviews: Dynamic via Judge.me Shopify App with custom Ghorer Bazar styling
  - Image Gallery: Thumbnails + Main image + Lightbox Zoom matching 2nd screenshot
  - Actions:
      * Add to Cart (Solid Orange -> Direct to /cart)
      * Buy Now (Dark Navy -> Direct to /cart)
      * Order on WhatsApp (Green -> WhatsApp with dynamic product details)
      * Call for Order (Blue -> tel: call with custom number)
  - Brand: Custom image upload option in Theme Customizer
  - Mobile: Full responsive layout matching mobile screenshot
  =============================================================================
{% endcomment %}

{% liquid
  assign curr_product = product
  assign curr_variant = curr_product.selected_or_first_available_variant

  assign p_title = curr_product.title
  assign p_price = curr_product.price | money
  assign p_compare_price = ''
  if curr_product.compare_at_price > curr_product.price
    assign p_compare_price = curr_product.compare_at_price | money
  endif
  assign p_id = curr_product.id
  assign p_variant_id = curr_variant.id
  assign p_sku = curr_variant.sku | default: 'SKU'
  assign p_url = curr_product.url

  # WhatsApp configuration
  assign wa_number = section.settings.whatsapp_number | default: '8801321208940'
  assign wa_custom_url = section.settings.whatsapp_url
  if wa_custom_url == blank
    assign wa_msg = 'Hello! I am interested in: Product: ' | append: p_title | append: ' | Price: ' | append: p_price | append: ' | SKU: ' | append: p_sku | append: ' | URL: ' | append: shop.url | append: p_url
    assign wa_url = 'https://wa.me/' | append: wa_number | append: '?text=' | append: wa_msg | url_encode
  else
    assign wa_url = wa_custom_url
  endif

  # Phone configuration
  assign call_number = section.settings.call_number | default: '8809642922922'

  # Brand configuration
  assign brand_logo = section.settings.brand_logo
  assign brand_url = section.settings.brand_url | default: '#'
  assign container_w = section.settings.container_width | default: 95

  # Dynamic Review Count from Judge.me / Shopify Reviews Metafield
  assign review_count = 0
  if curr_product.metafields.reviews.rating_count != blank
    assign review_count = curr_product.metafields.reviews.rating_count.value | default: curr_product.metafields.reviews.rating_count
  elsif curr_product.metafields.judgeme.badge != blank
    assign badge_parts = curr_product.metafields.judgeme.badge | split: 'data-number-of-reviews="'
    if badge_parts.size > 1
      assign review_count = badge_parts[1] | split: '"' | first
    endif
  endif
%}

<style>
  #shopify-section-{{ section.id }} .gh-pdp-section {
    width: 100%;
    padding-top: {{ section.settings.margin_top | default: 20 }}px;
    padding-bottom: {{ section.settings.margin_bottom | default: 50 }}px;
    background: {{ section.settings.section_bg | default: '#f8fafc' }};
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  .gh-pdp-container-{{ section.id }} {
    width: 100%;
    max-width: var(--container-max-width, 80%);
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  @media (max-width: 1600px) {
    .gh-pdp-container-{{ section.id }} {
      max-width: 95%;
    }
  }
  @media (max-width: 479px) {
    .gh-pdp-container-{{ section.id }} {
      max-width: 100%;
      padding: 0 12px;
    }
  }

  /* --------------------------------------------------------------------------
     1. BREADCRUMBS
     -------------------------------------------------------------------------- */
  .gh-pdp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: #64748b;
    margin-bottom: 20px;
  }

  .gh-pdp-breadcrumb a {
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s;
  }

  .gh-pdp-breadcrumb a:hover {
    color: #f37321;
  }

  .gh-pdp-breadcrumb-sep {
    color: #cbd5e1;
  }

  /* --------------------------------------------------------------------------
     2. MAIN PRODUCT CARD (WHITE BOX CONTAINER)
     -------------------------------------------------------------------------- */
  .gh-pdp-card {
    background: #ffffff;
    border: 1px solid #edf0f3;
    border-radius: 12px;
    padding: 30px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-bottom: 30px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.02);
  }

  /* --------------------------------------------------------------------------
     3. GALLERY: VERTICAL THUMBNAILS (LEFT) + MAIN IMAGE (RIGHT)
     -------------------------------------------------------------------------- */
  .gh-pdp-gallery-wrap {
    display: flex;
    gap: 16px;
    position: relative;
  }

  .gh-pdp-thumbs-col {
    width: 82px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 520px;
    overflow-y: auto;
    scrollbar-width: none;
  }

  .gh-pdp-thumbs-col::-webkit-scrollbar {
    display: none;
  }

  .gh-pdp-thumb-item {
    width: 82px;
    height: 82px;
    border: 1.5px solid #edf0f3;
    border-radius: 8px;
    background: #ffffff;
    padding: 4px;
    cursor: pointer;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .gh-pdp-thumb-item:hover {
    border-color: #cbd5e1;
  }

  .gh-pdp-thumb-item.is-active {
    border-color: #f37321;
    box-shadow: 0 0 0 1px #f37321;
  }

  .gh-pdp-thumb-item img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
  }

  .gh-pdp-main-img-wrap {
    flex: 1 1 auto;
    min-width: 0;
    position: relative;
    border: 1px solid #edf0f3;
    border-radius: 10px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 480px;
    cursor: zoom-in;
    overflow: hidden;
  }

  .gh-pdp-main-img {
    max-width: 92%;
    max-height: 460px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.3s ease;
  }

  .gh-pdp-zoom-icon {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    transition: all 0.2s;
  }

  .gh-pdp-zoom-icon:hover {
    background: #f37321;
    color: #ffffff;
    border-color: #f37321;
  }

  .gh-pdp-gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #edf0f3;
    color: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    transition: all 0.2s;
    z-index: 2;
  }

  .gh-pdp-gallery-arrow:hover {
    background: #f37321;
    color: #ffffff;
  }

  .gh-pdp-gallery-prev { left: 10px; }
  .gh-pdp-gallery-next { right: 10px; }

  /* --------------------------------------------------------------------------
     4. PRODUCT DETAILS (RIGHT COLUMN)
     -------------------------------------------------------------------------- */
  .gh-pdp-info-col {
    display: flex;
    flex-direction: column;
  }

  .gh-pdp-title {
    font-size: 24px;
    font-weight: 700;
    color: #1f2937;
    margin: 0 0 12px 0;
    line-height: 1.3;
  }

  .gh-pdp-price-wrap {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
  }

  .gh-pdp-price {
    font-size: 24px;
    font-weight: 700;
    color: #f37321;
  }

  .gh-pdp-compare-price {
    font-size: 16px;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .gh-pdp-short-desc {
    font-size: 14.5px;
    line-height: 1.6;
    color: #4b5563;
    margin-bottom: 22px;
  }

  .gh-pdp-divider {
    border: 0;
    border-top: 1px solid #edf0f3;
    margin: 0 0 22px 0;
  }

  /* Quantity Selector */
  .gh-pdp-qty-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 22px;
  }

  .gh-pdp-qty-label {
    font-size: 14.5px;
    font-weight: 600;
    color: #334155;
  }

  .gh-pdp-qty-box {
    display: inline-flex;
    align-items: center;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
    overflow: hidden;
    height: 38px;
  }

  .gh-pdp-qty-btn {
    width: 36px;
    height: 38px;
    border: none;
    background: transparent;
    color: #475569;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
  }

  .gh-pdp-qty-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .gh-pdp-qty-input {
    width: 46px;
    height: 38px;
    border: none;
    text-align: center;
    font-size: 15px;
    font-weight: 600;
    color: #1e293b;
    outline: none;
  }

  /* Action Buttons Grid */
  .gh-pdp-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 24px;
  }

  .gh-btn-pdp {
    height: 44px;
    border-radius: 6px;
    font-size: 14.5px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
    padding: 0 16px;
  }

  .gh-btn-pdp svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
    flex-shrink: 0;
  }

  /* 1. Add to Cart (Solid Orange -> Direct to Cart) */
  .gh-btn-addcart {
    background: #f37321;
    color: #ffffff;
  }

  .gh-btn-addcart:hover {
    background: #e06110;
    box-shadow: 0 4px 12px rgba(243, 115, 33, 0.25);
  }

  /* 2. Buy Now (Dark Navy -> Direct to Cart) */
  .gh-btn-buynow {
    background: #0f2b31;
    color: #ffffff;
  }

  .gh-btn-buynow:hover {
    background: #173d45;
    box-shadow: 0 4px 12px rgba(15, 43, 49, 0.25);
  }

  /* 3. Order on WhatsApp (Green) */
  .gh-btn-whatsapp {
    background: #25d366;
    color: #ffffff;
  }

  .gh-btn-whatsapp:hover {
    background: #20ba5a;
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.25);
  }

  /* 4. Call for Order (Blue) */
  .gh-btn-call {
    background: #1e3a8a;
    color: #ffffff;
  }

  .gh-btn-call:hover {
    background: #172e6b;
    box-shadow: 0 4px 12px rgba(30, 58, 138, 0.25);
  }

  /* Brand Logo Row */
  .gh-pdp-brand-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 10px;
    border-top: 1px solid #edf0f3;
  }

  .gh-pdp-brand-label {
    font-size: 14px;
    font-weight: 600;
    color: #475569;
  }

  .gh-pdp-brand-logo-wrap {
    display: inline-block;
  }

  .gh-pdp-brand-logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
    display: block;
  }

  /* --------------------------------------------------------------------------
     5. TABS: DESCRIPTION & CUSTOMER REVIEWS
     -------------------------------------------------------------------------- */
  .gh-pdp-tabs-container {
    background: #ffffff;
    border: 1px solid #edf0f3;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.02);
  }

  .gh-pdp-tabs-nav {
    display: flex;
    align-items: center;
    border-bottom: 2px solid #edf0f3;
    margin-bottom: 26px;
    gap: 30px;
  }

  .gh-pdp-tab-btn {
    position: relative;
    padding: 0 0 12px 0;
    background: transparent;
    border: none;
    font-size: 16px;
    font-weight: 700;
    color: #64748b;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .gh-pdp-tab-btn:hover {
    color: #1e293b;
  }

  .gh-pdp-tab-btn.is-active {
    color: #f37321;
  }

  .gh-pdp-tab-btn.is-active::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #f37321;
  }

  .gh-pdp-tab-pane {
    display: none;
  }

  .gh-pdp-tab-pane.is-active {
    display: block;
    animation: ghFadeIn 0.3s ease;
  }

  @keyframes ghFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .gh-pdp-desc-content {
    font-size: 15px;
    line-height: 1.8;
    color: #334155;
  }

  .gh-pdp-desc-content p {
    margin: 0 0 16px 0;
  }

  .gh-pdp-desc-content ul, .gh-pdp-desc-content ol {
    margin: 0 0 18px 24px;
    padding: 0;
  }

  .gh-pdp-desc-content li {
    margin-bottom: 8px;
  }

  .gh-pdp-desc-content img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  /* --------------------------------------------------------------------------
     6. CUSTOM REVIEW OVERVIEW & SUBMIT FORM (ALWAYS VISIBLE & CONNECTED TO JUDGE.ME)
     -------------------------------------------------------------------------- */
  .gh-judgeme-wrapper {
    width: 100%;
  }

  /* Force Judge.me stars to warm gold #ffb03d */
  .jdgm-star,
  .jdgm-star.jdgm--on,
  .jdgm-star.jdgm--half,
  .jdgm-rev__rating .jdgm-star,
  .jdgm-histogram__star .jdgm-star,
  .jdgm-prev-badge .jdgm-star {
    color: #ffb03d !important;
  }

  /* Hide Judge.me default unstyled header and form so our custom UI controls it */
  #judgeme_product_reviews .jdgm-rev-widg__header,
  #judgeme_product_reviews .jdgm-rev-widg__summary,
  #judgeme_product_reviews .jdgm-form-wrapper,
  #judgeme_product_reviews .jdgm-rev-widg__title {
    display: none !important;
  }

  /* Custom Overview 2-Column Grid (Left: Breakdown | Right: Submit Form) */
  .gh-reviews-overview-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 40px;
    padding-bottom: 30px;
    border-bottom: 1px solid #edf0f3;
    margin-bottom: 30px;
  }

  /* Left Column: Rating breakdown */
  .gh-reviews-summary-col {
    display: flex;
    flex-direction: column;
  }

  .gh-avg-rating-box {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 12px;
  }

  .gh-avg-score {
    font-size: 52px;
    font-weight: 800;
    color: #1e293b;
    line-height: 1;
    letter-spacing: -1px;
  }

  .gh-avg-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gh-avg-label {
    font-size: 14px;
    color: #475569;
    font-weight: 600;
  }

  .gh-avg-stars-wrap {
    display: flex;
    align-items: center;
    gap: 4px;
    color: #ffb03d;
    font-size: 15px;
  }

  .gh-avg-count-link {
    font-size: 13px;
    color: #64748b;
    margin-left: 6px;
    text-decoration: none;
  }

  .gh-recommended-badge {
    font-size: 13.5px;
    color: #334155;
    margin-bottom: 18px;
  }

  .gh-recommended-badge strong {
    color: #0f172a;
    font-weight: 700;
  }

  /* Histogram breakdown progress bars */
  .gh-histogram-list {
    display: flex;
    flex-direction: column;
    gap: 9px;
    width: 100%;
  }

  .gh-histogram-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: #64748b;
  }

  .gh-histogram-label {
    width: 44px;
    flex-shrink: 0;
  }

  .gh-histogram-bar {
    flex: 1 1 auto;
    height: 7px;
    background: #f1f5f9;
    border-radius: 4px;
    overflow: hidden;
  }

  .gh-histogram-fill {
    height: 100%;
    background: #ffb03d;
    border-radius: 4px;
  }

  .gh-histogram-percent {
    width: 40px;
    text-align: right;
    font-size: 12px;
    color: #64748b;
  }

  /* Right Column: Review Submission Form */
  .gh-review-form-col {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 24px;
  }

  .gh-review-form-title {
    font-size: 18px;
    font-weight: 700;
    color: #1e293b;
    margin: 0 0 4px 0;
  }

  .gh-review-form-subtitle {
    font-size: 13px;
    color: #64748b;
    margin: 0 0 16px 0;
  }

  .gh-form-group {
    margin-bottom: 14px;
  }

  .gh-form-group label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
    margin-bottom: 6px;
  }

  .gh-form-control {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    background: #ffffff;
    font-size: 13.5px;
    color: #1e293b;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .gh-form-control:focus {
    border-color: #f37321;
    box-shadow: 0 0 0 2px rgba(243, 115, 33, 0.15);
  }

  .gh-form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  /* Image Upload Area */
  .gh-review-upload-area {
    border: 2px dashed #cbd5e1;
    border-radius: 8px;
    padding: 16px;
    text-align: center;
    background: #ffffff;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }

  .gh-review-upload-area:hover {
    border-color: #f37321;
    background: #fffaf5;
  }

  .gh-upload-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gh-upload-icon {
    margin-bottom: 4px;
  }

  .gh-preview-container {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .gh-preview-thumb {
    width: 54px;
    height: 54px;
    border-radius: 6px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
  }

  .gh-preview-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gh-review-submit-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-top: 10px;
  }

  .gh-btn-submit-review {
    padding: 10px 26px;
    background: #1e293b;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    white-space: nowrap;
    height: 40px;
  }

  .gh-btn-submit-review:hover {
    background: #0f172a;
    transform: translateY(-1px);
  }

  .gh-review-alert {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13.5px;
    display: none;
  }

  .gh-review-alert.is-success {
    display: block;
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }

  .gh-review-alert.is-error {
    display: block;
    background: #fee2e2;
    color: #b91c1c;
    border: 1px solid #fecaca;
  }

  /* Empty State Message */
  .gh-no-reviews-box {
    text-align: center;
    padding: 30px 20px;
    background: #ffffff;
    border: 1px dashed #cbd5e1;
    border-radius: 8px;
    color: #64748b;
    font-size: 14.5px;
    margin-top: 10px;
  }

  /* Review Cards List */
  .jdgm-rev {
    padding: 20px 0 !important;
    border-bottom: 1px solid #f1f5f9 !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
  }

  .jdgm-rev__header {
    display: flex !important;
    align-items: center !important;
    gap: 12px !important;
  }

  .jdgm-rev__icon {
    width: 46px !important;
    height: 46px !important;
    border-radius: 50% !important;
    background: #f1f5f9 !important;
    color: #64748b !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-weight: 700 !important;
    flex-shrink: 0 !important;
  }

  .jdgm-rev__author {
    font-size: 15px !important;
    font-weight: 700 !important;
    color: #1e293b !important;
  }

  .jdgm-rev__timestamp {
    font-size: 12.5px !important;
    color: #94a3b8 !important;
    margin-left: 8px !important;
  }

  .jdgm-rev__rating {
    margin: 4px 0 !important;
  }

  .jdgm-rev__title {
    font-size: 15px !important;
    font-weight: 600 !important;
    color: #1e293b !important;
    margin: 4px 0 !important;
  }

  .jdgm-rev__body {
    font-size: 14px !important;
    color: #475569 !important;
    line-height: 1.65 !important;
  }

  /* --------------------------------------------------------------------------
     7. FULLSCREEN LIGHTBOX ZOOM MODAL (MATCHES 2ND SCREENSHOT)
     -------------------------------------------------------------------------- */
  .gh-lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.92);
    z-index: 99999;
    display: none;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .gh-lightbox-overlay.is-open {
    display: flex;
    animation: ghLightboxFadeIn 0.25s ease forwards;
  }

  @keyframes ghLightboxFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .gh-lightbox-topbar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    z-index: 10;
  }

  .gh-lightbox-counter {
    font-size: 15px;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 1px;
  }

  .gh-lightbox-close {
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: #ffffff;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s, transform 0.2s;
  }

  .gh-lightbox-close:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: scale(1.1);
  }

  .gh-lightbox-content {
    max-width: 85vw;
    max-height: 82vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .gh-lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    background: #ffffff;
    padding: 10px;
  }

  .gh-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 22px;
  }

  .gh-lightbox-nav:hover {
    background: #f37321;
    border-color: #f37321;
  }

  .gh-lightbox-prev { left: 24px; }
  .gh-lightbox-next { right: 24px; }

  /* --------------------------------------------------------------------------
     RESPONSIVE BREAKPOINTS (MATCHES MOBILE SCREENSHOT)
     -------------------------------------------------------------------------- */
  @media (max-width: 991px) {
    .gh-pdp-card {
      grid-template-columns: 1fr;
      gap: 25px;
      padding: 20px;
    }
    .gh-reviews-overview-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }

  @media (max-width: 767px) {
    .gh-pdp-gallery-wrap {
      flex-direction: column-reverse;
      gap: 12px;
    }
    .gh-pdp-thumbs-col {
      width: 100%;
      flex-direction: row;
      overflow-x: auto;
      max-height: none;
      padding-bottom: 4px;
    }
    .gh-pdp-thumb-item {
      width: 65px;
      height: 65px;
      flex-shrink: 0;
    }
    .gh-pdp-main-img-wrap {
      min-height: 320px;
    }
    .gh-pdp-title {
      font-size: 20px;
    }
    .gh-pdp-price {
      font-size: 21px;
    }
    /* 2x2 Action Buttons on Mobile */
    .gh-pdp-actions-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .gh-btn-pdp {
      height: 40px;
      font-size: 13px;
      padding: 0 10px;
    }
    .gh-pdp-tabs-container {
      padding: 18px 16px;
    }
    .gh-form-row-2 {
      grid-template-columns: 1fr;
    }
    .gh-review-submit-row {
      flex-direction: column;
      align-items: stretch;
    }
    .gh-review-submit-row > div {
      max-width: 100% !important;
    }
    .gh-btn-submit-review {
      width: 100%;
    }
    .gh-lightbox-prev { left: 8px; }
    .gh-lightbox-next { right: 8px; }
  }
</style>

<section class="gh-pdp-section" id="ghPdpSection-{{ section.id }}">
  <div class="container gh-pdp-container-{{ section.id }}">
    
    <!-- 1. BREADCRUMB NAVIGATION -->
