        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="gh-pdp-breadcrumb-sep">/</span>
      {% endif %}
      <span>{{ p_title }}</span>
    </div>

    <!-- 2. MAIN PRODUCT CARD -->
    <div class="gh-pdp-card">
      
      <!-- LEFT: GALLERY -->
      <div class="gh-pdp-gallery-wrap">
        
        <!-- Thumbnails Column -->
        <div class="gh-pdp-thumbs-col js-pdp-thumbs">
          {% if curr_product.images.size > 0 %}
