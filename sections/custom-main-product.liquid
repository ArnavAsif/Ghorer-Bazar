              <div class="gh-pdp-thumb-item {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" data-src="{{ img | image_url: width: 1200 }}">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ p_title | escape }}">
              </div>
            {% endfor %}
          {% else %}
            <div class="gh-pdp-thumb-item is-active" data-index="0" data-src="{{ 'product-1' | placeholder_svg_tag }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>

        <!-- Main Featured Image -->
        <div class="gh-pdp-main-img-wrap js-pdp-main-wrap">
          {% if curr_product.featured_image %}
            <img src="{{ curr_product.featured_image | image_url: width: 900 }}" alt="{{ p_title | escape }}" class="gh-pdp-main-img js-pdp-main-img">
