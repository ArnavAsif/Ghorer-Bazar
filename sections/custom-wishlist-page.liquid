{% comment %}
  =============================================================================
  CUSTOM WISHLIST PAGE SECTION
  - File: sections/custom-wishlist-page.liquid
  - Renders custom-wishlist-content snippet
  =============================================================================
{% endcomment %}

{% render 'custom-wishlist-content', section: section %}

{% schema %}
{
  "name": "Wishlist Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page Title",
      "default": "My Wishlist"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "container", "label": "Container (1320px)" },
        { "value": "container-fluid", "label": "Fluid Container (1820px)" },
        { "value": "narrow", "label": "Narrow Container (991px)" },
        { "value": "full", "label": "Full Width (100%)" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Desktop Grid Columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_add_all",
      "label": "Show 'Add All to Cart' Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_clear_all",
      "label": "Show 'Clear Wishlist' Button",
      "default": true
    },
    {
      "type": "header",
      "content": "Empty Wishlist State"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty State Title",
      "default": "Your Wishlist is Empty"
    },
    {
      "type": "textarea",
      "id": "empty_desc",
      "label": "Empty State Description",
      "default": "You haven't saved any items yet. Browse our fresh collection and tap the heart icon to save your favorite products!"
    },
    {
      "type": "text",
      "id": "empty_btn_label",
      "label": "Empty State Button Label",
      "default": "Explore Products"
    },
    {
      "type": "url",
      "id": "empty_btn_link",
      "label": "Empty State Button Link"
    }
  ],
  "presets": [
    {
      "name": "Wishlist Page"
    }
  ]
}
{% endschema %}
