<!-- ========================================================================
     ANIMATED SHOPPING CART LOADER OVERLAY (MATCHES USER'S 2ND IMAGE)
     ======================================================================== -->
<div class="gh-cart-modal-overlay" id="ghCartModalOverlay">
  <div class="gh-cart-modal-box">
    {% if custom_loader_img != blank %}
      <img src="{{ custom_loader_img | image_url: width: 200 }}" alt="Loading" class="gh-cart-custom-loader-img">
    {% else %}
      <div class="gh-cart-anim-wrap">
        <svg class="gh-cart-anim-svg" viewBox="0 0 100 100">
          <!-- Orange exclamation bouncing pills (User image 2) -->
          <g class="gh-drop-left">
            <circle cx="41" cy="16" r="4.5" fill="#f37321"/>
            <rect x="38" y="25" width="6.5" height="24" rx="3.25" fill="#f37321"/>
          </g>
          <g class="gh-drop-right">
            <rect x="58" y="26" width="6.5" height="24" rx="3.25" fill="#f37321" transform="rotate(18 61 38)"/>
            <circle cx="56" cy="54" r="4.5" fill="#f37321"/>
          </g>
          <!-- Black Cart Wireframe Outline -->
          <path d="M22 32 L32 32 L46 64 L74 64 L84 38 L30 38" fill="none" stroke="#111111" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"/>
          <line x1="40" y1="46" x2="78" y2="46" stroke="#111111" stroke-width="3"/>
          <line x1="43" y1="55" x2="75" y2="55" stroke="#111111" stroke-width="3"/>
          <line x1="50" y1="38" x2="48" y2="64" stroke="#111111" stroke-width="3"/>
          <line x1="60" y1="38" x2="59" y2="64" stroke="#111111" stroke-width="3"/>
          <line x1="70" y1="38" x2="70" y2="64" stroke="#111111" stroke-width="3"/>
          <!-- Bottom Wheels -->
          <circle cx="46" cy="74" r="5" fill="none" stroke="#111111" stroke-width="4.5"/>
          <circle cx="70" cy="74" r="5" fill="none" stroke="#111111" stroke-width="4.5"/>
        </svg>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function() {
    const modal = document.getElementById('ghCartModalOverlay');

    function showLoader() {
      if (modal) modal.classList.add('is-visible');
    }

    function hideLoader() {
      if (modal) {
        setTimeout(() => {
          modal.classList.remove('is-visible');
        }, 350);
      }
    }

    function updateHeaderBadge(totalItems) {
      document.querySelectorAll('.js-cart-badge-count').forEach(badge => {
        badge.textContent = totalItems;
      });
    }

    // Initialize Card States from Current Cart (/cart.js)
    function syncCardStatesWithCart(cart) {
      if (window.syncAllProductCards) {
        return window.syncAllProductCards(cart);
      }

      fetch('/cart.js')
        .then(res => res.json())
        .then(cartData => {
          updateHeaderBadge(cartData.item_count);

          const itemsMap = {};
          if (cartData && cartData.items) {
            cartData.items.forEach(item => {
              const vid = String(item.variant_id || item.id || '');
              if (vid) itemsMap[vid] = (itemsMap[vid] || 0) + Number(item.quantity || 0);
            });
          }

          document.querySelectorAll('.gh-top-card').forEach(card => {
            const variantId = String(card.dataset.variantId || '');
            if (card.querySelector('.js-gh-qty-box.is-locked')) return;

            const addBtn = card.querySelector('.js-gh-add-cart');
            const qtyBox = card.querySelector('.js-gh-qty-box');
            const qtyVal = card.querySelector('.js-gh-qty-val');

            const currentQty = itemsMap[variantId] || 0;

            if (currentQty > 0) {
              if (addBtn) addBtn.style.display = 'none';
              if (qtyBox) qtyBox.classList.add('is-active');
              if (qtyVal) qtyVal.textContent = currentQty;
            } else {
              if (addBtn) addBtn.style.display = '';
              if (qtyBox) qtyBox.classList.remove('is-active');
              if (qtyVal) qtyVal.textContent = '1';
            }

            const plusBtn = card.querySelector('.js-gh-qty-plus');
            if (plusBtn) {
              if (currentQty >= 20) {
                plusBtn.disabled = true;
                plusBtn.classList.add('is-disabled');
                plusBtn.setAttribute('aria-disabled', 'true');
              } else {
                plusBtn.disabled = false;
                plusBtn.classList.remove('is-disabled');
                plusBtn.removeAttribute('aria-disabled');
              }
            }
          });
        })
        .catch(() => {});
    }

    // 1. ADD TO CART CLICK (Instant 0ms UI, Debounced Async Cart)
    document.querySelectorAll('.js-gh-add-cart').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const card = this.closest('.gh-top-card');
        const variantId = String(this.dataset.variantId || (card ? card.dataset.variantId : '') || '');
        if (!variantId) return;
        if (card && card.querySelector('.js-gh-qty-box.is-locked')) return;

        let curQty = 0;
        const qBox = card ? card.querySelector('.js-gh-qty-box') : null;
        const qVal = card ? card.querySelector('.js-gh-qty-val') : null;
        if (qBox && qBox.classList.contains('is-active') && qVal) {
          curQty = parseInt(qVal.textContent, 10) || 0;
        }

        const nextQty = Math.min(20, curQty + 1);
        if (window.ghUpdateVariantQuantity) {
          window.ghUpdateVariantQuantity(variantId, nextQty, curQty === 0);
        }
      });
    });

    // 2. QUANTITY PLUS (+) (Instant 0ms UI, Max 20 Limit, Debounced Async Cart)
    document.querySelectorAll('.js-gh-qty-plus').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const card = this.closest('.gh-top-card');
        const variantId = String(card ? (card.dataset.variantId || '') : '');
        if (!variantId) return;
        if (card && card.querySelector('.js-gh-qty-box.is-locked')) return;

        const qtyVal = card ? card.querySelector('.js-gh-qty-val') : null;
        let currentQty = parseInt(qtyVal ? qtyVal.textContent : '1', 10) || 1;
        if (currentQty >= 20) return; // Disallow exceeding 20

        const nextQty = Math.min(20, currentQty + 1);
        if (window.ghUpdateVariantQuantity) {
          window.ghUpdateVariantQuantity(variantId, nextQty, false);
        }
      });
    });

    // 3. QUANTITY MINUS (-) (Instant 0ms UI, Debounced Async Cart)
    document.querySelectorAll('.js-gh-qty-minus').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const card = this.closest('.gh-top-card');
        const variantId = String(card ? (card.dataset.variantId || '') : '');
        if (!variantId) return;
        if (card && card.querySelector('.js-gh-qty-box.is-locked')) return;

        const qtyVal = card ? card.querySelector('.js-gh-qty-val') : null;
        let currentQty = parseInt(qtyVal ? qtyVal.textContent : '1', 10) || 1;
        const nextQty = Math.max(0, currentQty - 1);

        if (window.ghUpdateVariantQuantity) {
          window.ghUpdateVariantQuantity(variantId, nextQty, false);
        }
      });
    });

    // 4. BUY NOW CLICK (Adds to cart & redirects to /cart)
    document.querySelectorAll('.js-gh-buy-now').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const card = this.closest('.gh-top-card');
        const variantId = card ? card.dataset.variantId : '';

        showLoader();

        if (variantId && !variantId.startsWith('demo')) {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: variantId, quantity: 1 })
          })
            .then(() => {
              window.location.href = '/cart';
            })
            .catch(() => {
              window.location.href = '/cart';
            });
        } else {
          setTimeout(() => {
            window.location.href = '/cart';
          }, 450);
        }
      });
    });

    // Listen to global cart:updated events
    document.addEventListener('cart:updated', function(e) {
      if (e && e.detail && e.detail.cart) {
        if (window.syncAllProductCards) window.syncAllProductCards(e.detail.cart);
      } else if (window.syncAllProductCards) {
        window.syncAllProductCards();
      }
    });

    // Run initial sync
    syncCardStatesWithCart();
  })();
</script>

