{% comment %}
  =============================================================================
  SHOPIFY RESPONSIVE IMAGE BANNER SECTION
  - File: sections/custom-image-banner.liquid
  - Default Height: 345px on Desktop (exact requirement)
  - Responsive: Automatically scales down on Laptop, Tablet, and Mobile
  - Smooth Rounded Corners: 20px (customizable)
  =============================================================================
{% endcomment %}

{% liquid
  assign desktop_h = section.settings.desktop_height | default: 345
  assign tablet_h = section.settings.tablet_height | default: 225
  assign mobile_h = section.settings.mobile_height | default: 150
  assign radius = section.settings.border_radius | default: 20
  assign mobile_radius = section.settings.mobile_border_radius | default: 12
  assign section_width_setting = section.settings.section_width | default: 'container'
  case section_width_setting
    when 'container-fluid'
      assign section_max_w = '1820px'
    when 'narrow'
      assign section_max_w = '991px'
    when 'full'
      assign section_max_w = '100%'
    else
      assign section_max_w = 'var(--container-max-width, 80%)'
  endcase
  assign img_fit = section.settings.image_fit | default: 'cover'
  assign img_pos = section.settings.image_position | default: 'center center'
%}

<style>
  #shopify-section-{{ section.id }} {
    --section-max-width: {{ section_max_w }};
  }
  {% if section_width_setting == 'container' or section_width_setting == blank %}
    @media (max-width: 1600px) {
      #shopify-section-{{ section.id }} {
        --section-max-width: 95%;
      }
    }
    @media (max-width: 479px) {
      #shopify-section-{{ section.id }} {
        --section-max-width: 100%;
      }
    }
  {% endif %}

  #shopify-section-{{ section.id }} .gh-banner-section {
    padding-top: {{ section.settings.margin_top | default: 25 }}px;
    padding-bottom: {{ section.settings.margin_bottom | default: 25 }}px;
    width: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  .gh-banner-container-{{ section.id }} {
    width: 100%;
    max-width: var(--section-max-width);
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .gh-banner-card-{{ section.id }} {
    display: block;
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: {{ radius }}px;
    text-decoration: none;
    background: {{ section.settings.banner_bg | default: '#f4f5f7' }};
    {% if section.settings.enable_shadow %}
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    {% endif %}
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if section.settings.banner_link != blank %}
    .gh-banner-card-{{ section.id }}:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.09);
    }
  {% endif %}

  .gh-banner-media-{{ section.id }} {
    position: relative;
    width: 100%;
    height: {{ desktop_h }}px;
    overflow: hidden;
    border-radius: {{ radius }}px;
  }

  .gh-banner-img-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: {{ img_fit }};
    object-position: {{ img_pos }};
    display: block;
    transition: transform 0.4s ease;
  }

  {% if section.settings.banner_link != blank and section.settings.enable_hover_zoom %}
    .gh-banner-card-{{ section.id }}:hover .gh-banner-img-{{ section.id }} {
      transform: scale(1.02);
    }
  {% endif %}

  /* --------------------------------------------------------------------------
     RESPONSIVE HEIGHT BREAKPOINTS (Screen onujayi height kom-beshi)
     -------------------------------------------------------------------------- */
  /* Laptop / Small Desktop (992px - 1199px) */
  @media (max-width: 1199px) {
    .gh-banner-media-{{ section.id }} {
      height: calc({{ desktop_h }}px * 0.85);
    }
  }

  /* Tablet (768px - 991px) */
  @media (max-width: 991px) {
    .gh-banner-media-{{ section.id }} {
      height: {{ tablet_h }}px;
    }
  }

  /* Mobile (<= 767px) */
  @media (max-width: 767px) {
    .gh-banner-card-{{ section.id }},
    .gh-banner-media-{{ section.id }} {
      border-radius: {{ mobile_radius }}px;
      height: {{ mobile_h }}px;
    }
  }

  /* Small mobile (<= 479px): padding reduces to 12px */
  @media (max-width: 479px) {
    .gh-banner-container-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }
    .gh-banner-media-{{ section.id }} {
      height: calc({{ mobile_h }}px * 0.9);
    }
  }

  /* Extra small mobile (<= 375px) */
  @media (max-width: 375px) {
    .gh-banner-container-{{ section.id }} {
      padding-left: 12px;
      padding-right: 12px;
    }
  }
</style>

<div class="gh-banner-section" id="ghBannerSection-{{ section.id }}">
  <div class="container gh-banner-container-{{ section.id }}">
    
    {% if section.settings.banner_link != blank %}
      <a href="{{ section.settings.banner_link }}" class="gh-banner-card-{{ section.id }}" {% if section.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>
    {% else %}
      <div class="gh-banner-card-{{ section.id }}" style="cursor: default;">
    {% endif %}

      <div class="gh-banner-media-{{ section.id }}">
        {% if section.settings.image != blank %}
          <picture>
            {% if section.settings.mobile_image != blank %}
              <source media="(max-width: 767px)" srcset="{{ section.settings.mobile_image | image_url: width: 900 }}">
            {% endif %}
            <img
              src="{{ section.settings.image | image_url: width: 1920 }}"
              srcset="{{ section.settings.image | image_url: width: 600 }} 600w,
                      {{ section.settings.image | image_url: width: 900 }} 900w,
                      {{ section.settings.image | image_url: width: 1200 }} 1200w,
                      {{ section.settings.image | image_url: width: 1600 }} 1600w,
                      {{ section.settings.image | image_url: width: 1920 }} 1920w"
              sizes="(max-width: 767px) 100vw, {{ container_w }}vw"
              alt="{{ section.settings.alt_text | default: section.settings.image.alt | default: 'Banner' | escape }}"
              class="gh-banner-img-{{ section.id }}"
              loading="{{ section.settings.image_loading | default: 'lazy' }}"
              width="1920"
              height="{{ desktop_h }}"
            >
          </picture>
        {% elsif section.settings.demo_image_url != blank %}
          <img
            src="{{ section.settings.demo_image_url }}"
            alt="{{ section.settings.alt_text | default: 'Banner' | escape }}"
            class="gh-banner-img-{{ section.id }}"
            loading="lazy"
          >
        {% else %}
          <!-- DEFAULT DEMO BANNER -->
          <img
            src="{{ 'shosti-food-banner.png' | asset_url }}"
            alt="{{ section.settings.alt_text | default: 'Swasti Food Banner' | escape }}"
            class="gh-banner-img-{{ section.id }}"
            loading="lazy"
            onerror="this.onerror=null; this.src='https://backoffice.ghorerbazar.com/brand_images/7hNKq1768887947.png';"
          >
        {% endif %}
      </div>

    {% if section.settings.banner_link != blank %}
      </a>
    {% else %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Responsive Image Banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner Images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Banner Image",
      "info": "Recommended ratio ~5:1 (e.g., 1920x345px)"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Banner Image (Optional)",
      "info": "Optional vertical/compact image for mobile (<= 767px)"
    },
    {
      "type": "text",
      "id": "demo_image_url",
      "label": "External Image URL (Fallback)",
      "info": "Paste an external image link if no Shopify image is selected"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image Alt Text (SEO)",
      "default": "Promotional Banner"
    },
    {
      "type": "header",
      "content": "Responsive Height Settings"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 180,
      "max": 600,
      "step": 5,
      "unit": "px",
      "label": "Desktop Height (Default 345px)",
      "default": 345
    },
    {
      "type": "range",
      "id": "tablet_height",
      "min": 140,
      "max": 450,
      "step": 5,
      "unit": "px",
      "label": "Tablet Height (768px - 991px)",
      "default": 225
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 100,
      "max": 350,
      "step": 5,
      "unit": "px",
      "label": "Mobile Height (<= 767px)",
      "default": 150
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit Style",
      "options": [
        { "value": "cover", "label": "Cover (Fill without stretching, crops overflow)" },
        { "value": "contain", "label": "Contain (Show whole image without cropping)" },
        { "value": "fill", "label": "Fill (Stretch to exact container dimensions)" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Focal Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center left", "label": "Center Left" },
        { "value": "center right", "label": "Center Right" },
        { "value": "top center", "label": "Top Center" },
        { "value": "bottom center", "label": "Bottom Center" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Banner Link & Hover"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Banner Link (Optional)"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable subtle hover zoom",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout & Corners"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section Width",
      "options": [
        { "value": "container", "label": "Container (1320px)" },
        { "value": "container-fluid", "label": "Fluid Container (1820px)" },
        { "value": "narrow", "label": "Narrow Container (991px)" },
        { "value": "full", "label": "Full Width (100%)" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Desktop Corner Radius",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Mobile Corner Radius",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "label": "Enable Soft Shadow",
      "default": false
    },
    {
      "type": "color",
      "id": "banner_bg",
      "label": "Banner Background Color",
      "default": "#f4f5f7"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Spacing (px)",
      "default": 25
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Spacing (px)",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Responsive Image Banner",
      "settings": {
        "desktop_height": 345,
        "tablet_height": 225,
        "mobile_height": 150,
        "border_radius": 20
      }
    }
  ]
}
{% endschema %}