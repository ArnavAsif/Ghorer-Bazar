  <div class="gh-cart-overlay" id="ghCartOverlay"></div>

  <aside class="gh-cart-drawer" id="ghCartDrawer" aria-label="Shopping Cart Drawer">
    <!-- Header: SHOPPING CART | Close -> -->
    <div class="gh-cart-header">
      <span class="gh-cart-heading">SHOPPING CART</span>
      <button type="button" class="gh-cart-close" id="ghCartCloseBtn" aria-label="Close Cart">
        Close
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="gh-cart-body" id="ghCartBody">
      
      <!-- Empty Cart View (Screenshot 2) -->
      <div class="gh-cart-empty-view" id="ghCartEmptyView" style="{% if cart.item_count > 0 %}display:none;{% else %}display:flex;{% endif %}">
        <div class="gh-cart-empty-illustration">
          <img src="https://ghorerbazar.com/assets/img/empty_cart.png" alt="Empty Cart" onerror="this.src='https://cdn.shopify.com/s/files/1/0533/2089/files/empty-cart.png?v=1';">
        </div>
        <p class="gh-cart-empty-text">No items in your cart!</p>
      </div>

      <!-- Filled Cart Content Wrap (Screenshot 1 & Screenshot 13) -->
      <div class="gh-cart-filled-content" id="ghCartFilledContent" style="{% if cart.item_count == 0 %}display:none;{% else %}display:flex;{% endif %}">
        
        <!-- Cart Items List (Top Scrollable Area) -->
        <div class="gh-cart-items-wrap" id="ghCartItemsList">
          {% for item in cart.items %}
            <div class="gh-cart-item-card" data-key="{{ item.key }}">
              <div class="gh-cart-item-img-box">
                <img src="{{ item.image | image_url: width: 140 }}" alt="{{ item.title | escape }}" class="gh-cart-item-thumb" loading="lazy">
              </div>
              <div class="gh-cart-item-info">
                <span class="gh-cart-item-name" title="{{ item.title | escape }}">{{ item.title }}</span>
                <div class="gh-cart-item-row">
                  <div class="gh-cart-qty-box">
                    <button type="button" class="gh-cart-qty-btn js-qty-dec" data-key="{{ item.key }}" aria-label="Decrease quantity">-</button>
                    <span class="gh-cart-qty-val">{{ item.quantity }}</span>
                    <button type="button" class="gh-cart-qty-btn js-qty-inc" data-key="{{ item.key }}" aria-label="Increase quantity">+</button>
                  </div>
                  <span class="gh-cart-price-math">&times; {{ item.price | money }} = {{ item.final_line_price | money }}</span>
                </div>
              </div>
              <button type="button" class="gh-cart-item-remove js-item-remove" data-key="{{ item.key }}" aria-label="Remove Item">&times;</button>
            </div>
          {% endfor %}
        </div>

        <!-- Pinned Bottom Wrap: Recommendations + Total + Checkout -->
        <div class="gh-cart-bottom-wrap">
          <!-- "You May Also Like" Slider Section -->
          <div class="gh-cart-rec-section">
            <div class="gh-cart-rec-header">
              <div class="gh-cart-rec-title-wrap">
                <h4 class="gh-cart-rec-title">{{ section.settings.cart_rec_title | default: 'You May Also Like' }}</h4>
                <div class="gh-cart-rec-title-bar"></div>
              </div>
              <div class="gh-cart-rec-arrows">
                <button type="button" class="gh-rec-arrow prev" id="ghRecPrev" aria-label="Previous">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
                </button>
                <button type="button" class="gh-rec-arrow next" id="ghRecNext" aria-label="Next">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </button>
              </div>
            </div>

            <div class="gh-cart-rec-slider-wrap" id="ghRecSlider">
              {% if rec_collection != blank and rec_collection.products.size > 0 %}
                {% for prod in rec_collection.products limit: 10 %}
                  {% assign first_variant = prod.selected_or_first_available_variant %}
                  {% if first_variant.available %}
                    <div class="gh-cart-rec-card">
                      <div class="gh-rec-img-box">
                        {% if prod.featured_image %}
                          <img src="{{ prod.featured_image | image_url: width: 140 }}" alt="{{ prod.title | escape }}" class="gh-rec-thumb" loading="lazy">
                        {% else %}
                          <img src="https://backoffice.ghorerbazar.com/company_logo/qJaKf1768887846.png" alt="{{ prod.title | escape }}" class="gh-rec-thumb" loading="lazy">
                        {% endif %}
                      </div>
                      <div class="gh-rec-details">
                        <div class="gh-rec-name" title="{{ prod.title | escape }}">{{ prod.title }}</div>
                        <div class="gh-rec-price">{{ prod.price | money }}</div>
                        <button type="button" class="gh-rec-add-btn js-rec-add" data-variant-id="{{ first_variant.id }}" aria-label="Add {{ prod.title | escape }} to cart">
                          + Add
                        </button>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% else %}
                <div class="gh-cart-rec-card">
                  <div class="gh-rec-img-box">
                    <img src="https://backoffice.ghorerbazar.com/company_logo/qJaKf1768887846.png" class="gh-rec-thumb" alt="Product">
                  </div>
                  <div class="gh-rec-details">
                    <div class="gh-rec-name">Organic Jumbo Rolled Oats 500gm</div>
                    <div class="gh-rec-price">৳700.00</div>
                    <button type="button" class="gh-rec-add-btn js-rec-add" data-variant-id="">+ Add</button>
                  </div>
                </div>
                <div class="gh-cart-rec-card">
                  <div class="gh-rec-img-box">
                    <img src="https://backoffice.ghorerbazar.com/company_logo/qJaKf1768887846.png" class="gh-rec-thumb" alt="Product">
                  </div>
                  <div class="gh-rec-details">
                    <div class="gh-rec-name">Black Seed Honey 1kg</div>
                    <div class="gh-rec-price">৳1,600.00</div>
                    <button type="button" class="gh-rec-add-btn js-rec-add" data-variant-id="">+ Add</button>
                  </div>
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Total + Checkout -->
          <div class="gh-cart-footer">
            <div class="gh-cart-total-row">
              <span class="gh-cart-total-lbl">Total:</span>
              <span class="gh-cart-total-val" id="ghCartTotalVal">{{ cart.total_price | money }}</span>
            </div>
            <a href="/checkout" class="gh-cart-checkout-btn">CHECKOUT</a>
          </div>
        </div>

      </div>

    </div>
  </aside>

</div>

<script>
  (function() {
    function initCustomHeader() {
      const header = document.getElementById('ghCustomHeader');
      const middleBar = document.getElementById('ghMiddleBar');
      const navWrapper = document.getElementById('ghNavBarWrapper');
      const navBar = document.getElementById('ghNavBar');
      
      const drawer = document.getElementById('ghDrawer');
      const drawerOverlay = document.getElementById('ghDrawerOverlay');
      const drawerCloseBtn = document.getElementById('ghDrawerClose');
      const drawerOpenBtns = document.querySelectorAll('.js-gh-drawer-open');
      const accordionBtns = document.querySelectorAll('.js-drawer-acc-btn');

      const cartDrawer = document.getElementById('ghCartDrawer');
      const cartOverlay = document.getElementById('ghCartOverlay');
      const cartCloseBtn = document.getElementById('ghCartCloseBtn');
      const cartOpenBtns = document.querySelectorAll('.js-gh-cart-open');
      const cartEmptyView = document.getElementById('ghCartEmptyView');
      const cartFilledContent = document.getElementById('ghCartFilledContent');
      const cartItemsList = document.getElementById('ghCartItemsList');
      const cartTotalVal = document.getElementById('ghCartTotalVal');
      const badgeCounts = document.querySelectorAll('.js-cart-badge-count');

      const recSlider = document.getElementById('ghRecSlider');
      const recPrev = document.getElementById('ghRecPrev');
      const recNext = document.getElementById('ghRecNext');

      const moreWrap = document.querySelector('.gh-more-wrap');
      const moreBtn = document.querySelector('.gh-more-btn');

      if (!header) return;

      /* Desktop Navlink Sticky Scroll (> 1000px only) */
      if (navBar && navWrapper) {
        let isSticky = false;
        let ticking = false;

        function updateNavSticky() {
          const isDesktop = window.innerWidth > 1000;
          if (!isDesktop) {
            if (isSticky) {
              navBar.classList.remove('is-nav-sticky');
              navWrapper.style.height = '';
              isSticky = false;
            }
            ticking = false;
            return;
          }

          const triggerPoint = middleBar ? middleBar.offsetHeight : 80;
          const currentScroll = window.scrollY || window.pageYOffset;

          if (currentScroll > triggerPoint) {
            if (!isSticky) {
              navWrapper.style.height = navBar.offsetHeight + 'px';
              navBar.classList.add('is-nav-sticky');
              isSticky = true;
            }
          } else {
            if (isSticky) {
              navBar.classList.remove('is-nav-sticky');
              navWrapper.style.height = '';
              isSticky = false;
            }
          }
          ticking = false;
        }

        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(updateNavSticky);
            ticking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', updateNavSticky);
        updateNavSticky();
      }

      /* Desktop More Button Dropdown (Does NOT open drawer) */
      if (moreBtn && moreWrap) {
        moreBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          moreWrap.classList.toggle('is-open');
        });
        document.addEventListener('click', function(e) {
          if (!e.target.closest('.gh-more-wrap')) {
            moreWrap.classList.remove('is-open');
          }
        });
      }

      /* Left Nav Drawer */
      function openNavDrawer() {
        closeCartDrawer();
        if (drawer && drawerOverlay) {
          drawer.classList.add('is-active');
          drawerOverlay.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeNavDrawer() {
        if (drawer && drawerOverlay) {
          drawer.classList.remove('is-active');
          drawerOverlay.classList.remove('is-active');
          if (!cartDrawer || !cartDrawer.classList.contains('is-active')) {
            document.body.style.overflow = '';
          }
        }
      }

      drawerOpenBtns.forEach(btn => btn.addEventListener('click', e => {
        e.preventDefault();
        openNavDrawer();
      }));
      if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeNavDrawer);
      if (drawerOverlay) drawerOverlay.addEventListener('click', closeNavDrawer);

      /* Right Cart Drawer */
      function openCartDrawer() {
        closeNavDrawer();
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.add('is-active');
          cartOverlay.classList.add('is-active');
          document.body.style.overflow = 'hidden';
          // Always refresh cart data live on opening
          window.refreshGhorerCart(false);
        }
      }

      function closeCartDrawer() {
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.remove('is-active');
          cartOverlay.classList.remove('is-active');
          if (!drawer || !drawer.classList.contains('is-active')) {
            document.body.style.overflow = '';
          }
        }
      }

      cartOpenBtns.forEach(btn => btn.addEventListener('click', function(e) {
        e.preventDefault();
        openCartDrawer();
      }));
      if (cartCloseBtn) cartCloseBtn.addEventListener('click', closeCartDrawer);
      if (cartOverlay) cartOverlay.addEventListener('click', closeCartDrawer);

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          closeNavDrawer();
          closeCartDrawer();
        }
      });

      /* Accordion */
      accordionBtns.forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          const parentRow = btn.closest('.gh-drawer-item');
          const submenu = parentRow ? parentRow.querySelector('.gh-drawer-submenu') : null;
          if (submenu) {
            const isOpen = submenu.classList.contains('is-open');
            if (isOpen) {
              submenu.classList.remove('is-open');
              btn.classList.remove('is-open');
            } else {
              submenu.classList.add('is-open');
              btn.classList.add('is-open');
            }
          }
        });
      });

      /* Slider buttons for Recommended Products */
      if (recPrev && recSlider) {
        recPrev.addEventListener('click', function(e) {
          e.preventDefault();
          recSlider.scrollBy({ left: -250, behavior: 'smooth' });
        });
      }
      if (recNext && recSlider) {
        recNext.addEventListener('click', function(e) {
          e.preventDefault();
          recSlider.scrollBy({ left: 250, behavior: 'smooth' });
        });
      }

      /* Helpers */
      function escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      function formatMoney(cents) {
        if (isNaN(cents)) return '৳0.00';
        const val = (cents / 100).toFixed(2);
        const parts = val.split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return '৳' + parts.join('.');
      }

      /* Cart UI Update */
      function updateCartUI(cart) {
        if (!cart) return;

        // 1. Update badges
        const count = cart.item_count !== undefined ? cart.item_count : 0;
        document.querySelectorAll('.js-cart-badge-count').forEach(badge => {
          badge.textContent = count;
        });

        // 2. Empty vs Filled view
        if (count === 0 || !cart.items || cart.items.length === 0) {
          if (cartEmptyView) cartEmptyView.style.display = 'flex';
          if (cartFilledContent) cartFilledContent.style.display = 'none';
          if (cartTotalVal) cartTotalVal.textContent = '৳0.00';
          if (cartItemsList) cartItemsList.innerHTML = '';
          return;
        }

        if (cartEmptyView) cartEmptyView.style.display = 'none';
        if (cartFilledContent) cartFilledContent.style.display = 'flex';

        // 3. Update total
        if (cartTotalVal) {
          cartTotalVal.textContent = formatMoney(cart.total_price);
        }

        // 4. Update items list (Matches Screenshot_13.png)
        if (cartItemsList) {
          let html = '';
          cart.items.forEach(item => {
            const imgUrl = (item.featured_image && item.featured_image.url) ? item.featured_image.url : (item.image || 'https://ghorerbazar.com/assets/img/empty_cart.png');
            const itemTitle = item.title || item.product_title || '';
            const unitPrice = formatMoney(item.final_price !== undefined ? item.final_price : item.price);
            const linePrice = formatMoney(item.final_line_price !== undefined ? item.final_line_price : item.line_price);

            html += `
              <div class="gh-cart-item-card" data-key="${item.key}">
                <div class="gh-cart-item-img-box">
                  <img src="${imgUrl}" alt="${escapeHtml(itemTitle)}" class="gh-cart-item-thumb" loading="lazy">
                </div>
                <div class="gh-cart-item-info">
                  <span class="gh-cart-item-name" title="${escapeHtml(itemTitle)}">${escapeHtml(itemTitle)}</span>
                  <div class="gh-cart-item-row">
                    <div class="gh-cart-qty-box">
                      <button type="button" class="gh-cart-qty-btn js-qty-dec" data-key="${item.key}" aria-label="Decrease quantity">-</button>
                      <span class="gh-cart-qty-val">${item.quantity}</span>
                      <button type="button" class="gh-cart-qty-btn js-qty-inc" data-key="${item.key}" aria-label="Increase quantity"${item.quantity >= 20 ? ' disabled' : ''}>+</button>
                    </div>
                    <span class="gh-cart-price-math">&times; ${unitPrice} = ${linePrice}</span>
                  </div>
                </div>
                <button type="button" class="gh-cart-item-remove js-item-remove" data-key="${item.key}" aria-label="Remove Item">&times;</button>
              </div>
            `;
          });
          cartItemsList.innerHTML = html;
        }
      }

      const MAX_QTY = 20;
      const DEBOUNCE_MS = 180;

      // State tracking maps by variantId
      const targetQuantities = {};
      const isInitialAddMap = {};
      const debounceTimers = {};
      const isLockedMap = {};

      function lockCardsUI(vid) {
        isLockedMap[vid] = true;
        document.querySelectorAll(`[data-variant-id="${vid}"]`).forEach(card => {
          const qtyBox = card.matches('.js-pcard-qty-box, .js-gh-qty-box') ? card : card.querySelector('.js-pcard-qty-box, .js-gh-qty-box');
          if (qtyBox) qtyBox.classList.add('is-locked');
          const plusBtn = card.matches('.js-pcard-qty-plus, .js-gh-qty-plus') ? card : card.querySelector('.js-pcard-qty-plus, .js-gh-qty-plus');
          const minusBtn = card.matches('.js-pcard-qty-minus, .js-gh-qty-minus') ? card : card.querySelector('.js-pcard-qty-minus, .js-gh-qty-minus');
          if (plusBtn) {
            plusBtn.disabled = true;
            plusBtn.classList.add('is-disabled');
            plusBtn.setAttribute('aria-disabled', 'true');
          }
          if (minusBtn) {
            minusBtn.disabled = true;
            minusBtn.classList.add('is-disabled');
            minusBtn.setAttribute('aria-disabled', 'true');
          }
        });
      }

      function unlockCardsUI(vid, confirmedQty) {
        delete isLockedMap[vid];
        document.querySelectorAll(`[data-variant-id="${vid}"]`).forEach(card => {
          const qtyBox = card.matches('.js-pcard-qty-box, .js-gh-qty-box') ? card : card.querySelector('.js-pcard-qty-box, .js-gh-qty-box');
          const plusBtn = card.matches('.js-pcard-qty-plus, .js-gh-qty-plus') ? card : card.querySelector('.js-pcard-qty-plus, .js-gh-qty-plus');
          const minusBtn = card.matches('.js-pcard-qty-minus, .js-gh-qty-minus') ? card : card.querySelector('.js-pcard-qty-minus, .js-gh-qty-minus');

          if (qtyBox) qtyBox.classList.remove('is-locked');

          if (minusBtn) {
            minusBtn.disabled = false;
            minusBtn.classList.remove('is-disabled');
            minusBtn.removeAttribute('aria-disabled');
          }

          if (plusBtn) {
            const checkValEl = card.matches('.js-pcard-qty-val, .js-gh-qty-val') ? card : card.querySelector('.js-pcard-qty-val, .js-gh-qty-val');
            const checkQty = confirmedQty !== undefined ? confirmedQty : (parseInt(checkValEl?.textContent || '0', 10));
            if (checkQty >= MAX_QTY) {
              plusBtn.disabled = true;
              plusBtn.classList.add('is-disabled');
              plusBtn.setAttribute('aria-disabled', 'true');
            } else {
              plusBtn.disabled = false;
              plusBtn.classList.remove('is-disabled');
              plusBtn.removeAttribute('aria-disabled');
            }
          }
        });
      }

      function updateCardsUIOptimistic(vid, qty) {
        document.querySelectorAll(`[data-variant-id="${vid}"]`).forEach(card => {
          const addBtn = card.matches('.js-pcard-add-btn, .js-gh-add-cart') ? card : card.querySelector('.js-pcard-add-btn, .js-gh-add-cart');
          const qtyBox = card.matches('.js-pcard-qty-box, .js-gh-qty-box') ? card : card.querySelector('.js-pcard-qty-box, .js-gh-qty-box');
          const qtyVal = card.matches('.js-pcard-qty-val, .js-gh-qty-val') ? card : card.querySelector('.js-pcard-qty-val, .js-gh-qty-val');
          const plusBtn = card.matches('.js-pcard-qty-plus, .js-gh-qty-plus') ? card : card.querySelector('.js-pcard-qty-plus, .js-gh-qty-plus');

          if (qty > 0) {
            if (addBtn) addBtn.style.display = 'none';
            if (qtyBox) qtyBox.classList.add('is-active');
            if (qtyVal) qtyVal.textContent = qty;
          } else {
            if (addBtn) addBtn.style.display = '';
            if (qtyBox) qtyBox.classList.remove('is-active');
            if (qtyVal) qtyVal.textContent = '1';
          }

          if (plusBtn) {
            if (qty >= MAX_QTY) {
              plusBtn.disabled = true;
              plusBtn.classList.add('is-disabled');
              plusBtn.setAttribute('aria-disabled', 'true');
            } else {
              plusBtn.disabled = false;
              plusBtn.classList.remove('is-disabled');
              plusBtn.removeAttribute('aria-disabled');
            }
          }
        });
      }

      /* Global Product Cards Synchronizer (syncs .js-gh-product-card and .gh-top-card across the page) */
      window.syncAllProductCards = function(cart) {
        if (!cart || !Array.isArray(cart.items)) {
          return fetch('/cart.js')
            .then(res => res.json())
            .then(c => {
              if (c) window.syncAllProductCards(c);
              return c;
            })
            .catch(() => {});
        }

        const itemsMap = {};
        let totalCount = 0;
        cart.items.forEach(item => {
          const vid = String(item.variant_id || item.id || '');
          if (vid) {
            itemsMap[vid] = (itemsMap[vid] || 0) + Number(item.quantity || 0);
          }
          totalCount += Number(item.quantity || 0);
        });

        const badgeCount = cart.item_count !== undefined ? cart.item_count : totalCount;
        document.querySelectorAll('.js-cart-badge-count').forEach(badge => {
          badge.textContent = badgeCount;
        });

        // 1. Snippet product cards (.js-gh-product-card)
        document.querySelectorAll('.js-gh-product-card').forEach(card => {
          const variantId = String(card.dataset.variantId || '');
          // Do not overwrite cards that are currently locked or debouncing
          if (variantId && (isLockedMap[variantId] || targetQuantities[variantId] !== undefined)) {
            return;
          }

          const addBtn = card.querySelector('.js-pcard-add-btn');
          const qtyBox = card.querySelector('.js-pcard-qty-box');
          const qtyVal = card.querySelector('.js-pcard-qty-val');
          const plusBtn = card.querySelector('.js-pcard-qty-plus');
          const currentQty = itemsMap[variantId] || 0;

          if (currentQty > 0) {
            if (addBtn) addBtn.style.display = 'none';
            if (qtyBox) qtyBox.classList.add('is-active');
            if (qtyVal) qtyVal.textContent = currentQty;
          } else {
            if (addBtn) addBtn.style.display = '';
            if (qtyBox) qtyBox.classList.remove('is-active');
            if (qtyVal) qtyVal.textContent = '1';
          }

          if (plusBtn) {
            if (currentQty >= MAX_QTY) {
              plusBtn.disabled = true;
              plusBtn.classList.add('is-disabled');
              plusBtn.setAttribute('aria-disabled', 'true');
            } else {
              plusBtn.disabled = false;
              plusBtn.classList.remove('is-disabled');
              plusBtn.removeAttribute('aria-disabled');
            }
          }
        });

        // 2. Top-selling cards (.gh-top-card)
        document.querySelectorAll('.gh-top-card').forEach(card => {
          const variantId = String(card.dataset.variantId || '');
          // Do not overwrite cards that are currently locked or debouncing
          if (variantId && (isLockedMap[variantId] || targetQuantities[variantId] !== undefined)) {
            return;
          }

          const addBtn = card.querySelector('.js-gh-add-cart');
          const qtyBox = card.querySelector('.js-gh-qty-box');
          const qtyVal = card.querySelector('.js-gh-qty-val');
          const plusBtn = card.querySelector('.js-gh-qty-plus');
          const currentQty = itemsMap[variantId] || 0;

          if (currentQty > 0) {
            if (addBtn) addBtn.style.display = 'none';
            if (qtyBox) qtyBox.classList.add('is-active');
            if (qtyVal) qtyVal.textContent = currentQty;
          } else {
            if (addBtn) addBtn.style.display = '';
            if (qtyBox) qtyBox.classList.remove('is-active');
            if (qtyVal) qtyVal.textContent = '1';
          }

          if (plusBtn) {
            if (currentQty >= MAX_QTY) {
              plusBtn.disabled = true;
              plusBtn.classList.add('is-disabled');
              plusBtn.setAttribute('aria-disabled', 'true');
            } else {
              plusBtn.disabled = false;
              plusBtn.classList.remove('is-disabled');
              plusBtn.removeAttribute('aria-disabled');
            }
          }
        });

        return Promise.resolve(cart);
      };
      window.syncGhProductCardsWithCart = window.syncAllProductCards;

      /* Optimized Asynchronous Variant Quantity Queue (Instant UI, Debounced API, Max 20, Locked during requests, No Race Conditions) */
      window.ghUpdateVariantQuantity = function(variantId, nextQty, isInitialAdd = false) {
        const vid = String(variantId || '');
        if (!vid) return;

        // Block clicks while this variant is actively locked / in-flight
        if (isLockedMap[vid]) return;

        const cappedQty = Math.min(MAX_QTY, Math.max(0, nextQty));
        targetQuantities[vid] = cappedQty;
        if (isInitialAdd && isInitialAddMap[vid] === undefined) {
          isInitialAddMap[vid] = true;
        }

        // 1. 0ms Instant Optimistic UI Update across all cards on page
        updateCardsUIOptimistic(vid, cappedQty);

        // 2. Demo fallback handling
        if (vid.startsWith('demo')) {
          lockCardsUI(vid);
          setTimeout(() => {
            unlockCardsUI(vid, cappedQty);
            delete targetQuantities[vid];
            delete isInitialAddMap[vid];
            document.dispatchEvent(new CustomEvent('cart:updated', { detail: { variantId: vid, quantity: cappedQty } }));
            if (window.refreshGhorerCart) window.refreshGhorerCart(false);
          }, 150);
          return;
        }

        // 3. Consolidate rapid clicks within DEBOUNCE_MS (180ms)
        if (debounceTimers[vid]) {
          clearTimeout(debounceTimers[vid]);
        }

        debounceTimers[vid] = setTimeout(() => {
          delete debounceTimers[vid];
          executeLockedCartSync(vid);
        }, DEBOUNCE_MS);
      };

      function executeLockedCartSync(vid) {
        const finalTarget = targetQuantities[vid];
        if (finalTarget === undefined) return;
        const wasInitialAdd = Boolean(isInitialAddMap[vid]);

        // If user added then immediately decremented back to 0 before debounce fired, cancel without API call
        if (wasInitialAdd && finalTarget === 0) {
          delete targetQuantities[vid];
          delete isInitialAddMap[vid];
          updateCardsUIOptimistic(vid, 0);
          return;
        }

        // Lock controls to prevent clicking +/- back and forth while request is in flight
        lockCardsUI(vid);

        const useAdd = wasInitialAdd && finalTarget > 0;
        const endpoint = useAdd ? '/cart/add.js' : '/cart/change.js';
        const payload = { id: vid, quantity: finalTarget };

        // Safety fallback timer (8s) to ensure UI never gets permanently locked on network loss
        const safetyTimer = setTimeout(() => {
          unlockCardsUI(vid);
          delete targetQuantities[vid];
          delete isInitialAddMap[vid];
        }, 8000);

        fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(res => {
          if (!res.ok) {
            const fallbackEndpoint = useAdd ? '/cart/change.js' : '/cart/add.js';
            return fetch(fallbackEndpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify(payload)
            }).then(r => r.json());
          }
          return res.json();
        })
        .then(() => {
          clearTimeout(safetyTimer);
          delete targetQuantities[vid];
          delete isInitialAddMap[vid];

          // Fetch authoritative cart to guarantee exact synchronization
          return fetch('/cart.js')
            .then(r => r.json())
            .then(cart => {
              let confirmedQty = 0;
              if (cart && Array.isArray(cart.items)) {
                cart.items.forEach(item => {
                  const itemVid = String(item.variant_id || item.id || '');
                  if (itemVid === vid) {
                    confirmedQty += Number(item.quantity || 0);
                  }
                });
              }

              // Unlock controls and set verified quantity
              unlockCardsUI(vid, confirmedQty);
              updateCardsUIOptimistic(vid, confirmedQty);

              if (window.syncAllProductCards) {
                window.syncAllProductCards(cart);
              }
              if (window.refreshGhorerCart) {
                window.refreshGhorerCart(false);
              }
              document.dispatchEvent(new CustomEvent('cart:updated', {
                detail: { variantId: vid, quantity: confirmedQty, cart: cart }
              }));
            });
        })
        .catch(err => {
          clearTimeout(safetyTimer);
          console.error('Cart sync error:', err);
          delete targetQuantities[vid];
          delete isInitialAddMap[vid];
          unlockCardsUI(vid);
          if (window.syncAllProductCards) {
            window.syncAllProductCards();
          }
        });
      }

      /* Global Live Cart Refresh */
      window.refreshGhorerCart = function(openDrawer = false) {
        return fetch('/cart.js')
          .then(res => res.json())
          .then(cart => {
            updateCartUI(cart);
            if (window.syncAllProductCards) {
              window.syncAllProductCards(cart);
            }
            if (openDrawer) {
              openCartDrawer();
            }
            return cart;
          })
          .catch(err => {
            console.error('Error fetching cart:', err);
          });
      };

      /* Change Cart Item Quantity / Remove */
      function changeCartItem(key, quantity) {
        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: key, quantity: Math.min(MAX_QTY, quantity) })
        })
        .then(res => res.json())
        .then(cart => {
          updateCartUI(cart);
          if (window.syncAllProductCards) {
            window.syncAllProductCards(cart);
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { key, quantity, cart } }));
        })
        .catch(err => console.error('Error updating cart item:', err));
      }

      /* Cart Item Quantity Increment / Decrement / Remove Event Delegation */
      document.addEventListener('click', function(e) {
        const decBtn = e.target.closest('.js-qty-dec');
        const incBtn = e.target.closest('.js-qty-inc');
        const removeBtn = e.target.closest('.js-item-remove');

        if (decBtn) {
          e.preventDefault();
          const key = decBtn.dataset.key;
          const card = decBtn.closest('.gh-cart-item-card');
          const qtyVal = card ? card.querySelector('.gh-cart-qty-val') : null;
          const currentQty = qtyVal ? (parseInt(qtyVal.textContent, 10) || 1) : 1;
          changeCartItem(key, Math.max(0, currentQty - 1));
        } else if (incBtn) {
          e.preventDefault();
          const key = incBtn.dataset.key;
          const card = incBtn.closest('.gh-cart-item-card');
          const qtyVal = card ? card.querySelector('.gh-cart-qty-val') : null;
          const currentQty = qtyVal ? (parseInt(qtyVal.textContent, 10) || 1) : 1;
          if (currentQty >= MAX_QTY) return;
          changeCartItem(key, Math.min(MAX_QTY, currentQty + 1));
        } else if (removeBtn) {
          e.preventDefault();
          const key = removeBtn.dataset.key;
          changeCartItem(key, 0);
        }
      });

      /* "+ Add" Button Click for Recommended Products */
      document.addEventListener('click', function(e) {
        const recAddBtn = e.target.closest('.js-rec-add');
        if (!recAddBtn) return;
        e.preventDefault();
        const variantId = recAddBtn.dataset.variantId;
        if (!variantId || variantId.startsWith('demo')) {
          const origText = recAddBtn.innerHTML;
          recAddBtn.textContent = 'Added ✓';
          setTimeout(() => { recAddBtn.innerHTML = origText; }, 1200);
          return;
        }

        const origText = recAddBtn.innerHTML;
        recAddBtn.textContent = '...';
        recAddBtn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(res => res.json())
        .then(() => {
          recAddBtn.textContent = 'Added ✓';
          setTimeout(() => {
            recAddBtn.innerHTML = origText;
            recAddBtn.disabled = false;
          }, 1200);
          return window.refreshGhorerCart(false); // DO NOT OPEN DRAWER / SILENT
        })
        .then(cart => {
          if (window.syncAllProductCards && cart) {
            window.syncAllProductCards(cart);
          }
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { variantId, quantity: 1, cart } }));
        })
        .catch(err => {
          console.error('Error adding recommended product to cart:', err);
          recAddBtn.innerHTML = origText;
          recAddBtn.disabled = false;
        });
      });

      /* Listen to global cart:updated events */
      document.addEventListener('cart:updated', function(e) {
        if (e && e.detail && e.detail.cart) {
          updateCartUI(e.detail.cart);
          if (window.syncAllProductCards) {
            window.syncAllProductCards(e.detail.cart);
          }
        } else if (window.refreshGhorerCart) {
          window.refreshGhorerCart(false);
        }
      });

      /* Global Fetch Interceptor to catch any /cart/ mutations across the whole store */
      if (!window._ghCartFetchIntercepted) {
        window._ghCartFetchIntercepted = true;
        const origFetch = window.fetch;
        window.fetch = function(...args) {
          const url = typeof args[0] === 'string' ? args[0] : (args[0] && args[0].url ? args[0].url : '');
          const promise = origFetch.apply(this, args);
          if (typeof url === 'string' && (url.includes('/cart/add') || url.includes('/cart/change') || url.includes('/cart/clear'))) {
            promise.then(res => {
              if (res.ok && window.refreshGhorerCart) {
                setTimeout(() => {
                  window.refreshGhorerCart(false).then(cart => {
                    if (window.syncAllProductCards && cart) {
                      window.syncAllProductCards(cart);
                    }
                  });
                }, 150);
              }
            }).catch(() => {});
          }
          return promise;
        };
      }

      /* Initial cart & cards load */
      window.refreshGhorerCart(false);

    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCustomHeader);
    } else {
      initCustomHeader();
    }
  })();
</script>

