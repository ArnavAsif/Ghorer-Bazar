  /* Breakpoints: Desktop (> 991px), Tablet (768px - 991px), Mobile (<= 767px) */
  @media (min-width: 768px) and (max-width: 991px) {
    .gh-tablet-hamburger { display: inline-flex !important; }
    .gh-action-label { display: none !important; }
    .gh-actions { gap: 14px; }
    .gh-nav-bar-wrapper { display: none !important; }
    .gh-header-mobile, .gh-mobile-search-bar { display: none !important; }
  }

  @media (min-width: 992px) {
    .gh-tablet-hamburger { display: none !important; }
    .gh-action-label { display: block; }
    .gh-nav-bar-wrapper { display: block !important; }
    .gh-header-mobile, .gh-mobile-search-bar { display: none !important; }
  }

  @media (max-width: 767px) {
