  /* Locked State & Localized Mini Spinner for Product Cards Quantity Selector */
  .gh-pcard-qty-box.is-locked,
  .gh-qty-box-wrap.is-locked {
    position: relative;
    pointer-events: none;
  }
  .gh-pcard-qty-box.is-locked .gh-pcard-qty-btn,
  .gh-qty-box-wrap.is-locked .gh-qty-btn {
    opacity: 0.35;
    cursor: not-allowed !important;
    pointer-events: none;
  }
  .gh-pcard-qty-box.is-locked .gh-pcard-qty-val,
  .gh-qty-box-wrap.is-locked .gh-qty-val {
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }
  .gh-pcard-qty-box.is-locked::after,
  .gh-qty-box-wrap.is-locked::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 13px;
    margin: -6.5px 0 0 -6.5px;
    border: 2px solid rgba(243, 115, 33, 0.25);
    border-top-color: #f37321;
    border-radius: 50%;
    animation: ghMiniSpin 0.6s linear infinite;
    pointer-events: none;
    z-index: 2;
