  /* ==========================================================================
     CIRCULAR BACK TO TOP (Matches Screenshot_3.png)
     ========================================================================== */
  .gh-back-to-top {
    position: fixed;
    bottom: 28px;
    right: 28px;
    width: 48px;
    height: 48px;
    z-index: 995;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(14px) scale(0.88);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .gh-back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .gh-btt-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .gh-btt-track {
    stroke: rgba(243, 115, 33, 0.15);
  }

  .gh-btt-progress {
    stroke: var(--gh-accent, #f37321);
    transition: stroke-dashoffset 0.08s linear;
  }

  .gh-btt-inner {
    width: 37px;
    height: 37px;
    border-radius: 50%;
    background-color: var(--gh-accent, #f37321);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(243, 115, 33, 0.38);
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .gh-back-to-top:hover .gh-btt-inner {
    transform: scale(1.06);
    background-color: var(--gh-accent-hover, #e06010);
    box-shadow: 0 6px 18px rgba(243, 115, 33, 0.48);
  }

  .gh-btt-inner svg {
    display: block;
    stroke: #ffffff;
  }

  @media (max-width: 767px) {
    .gh-back-to-top {
      bottom: 20px;
      right: 16px;
      width: 44px;
      height: 44px;
    }
    .gh-btt-inner {
      width: 34px;
      height: 34px;
    }
    .gh-btt-inner svg {
      width: 16px;
      height: 16px;
    }
  }

