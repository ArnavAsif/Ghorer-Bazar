{% comment %}
  =============================================================================
  SHOPIFY CUSTOM HEADER SECTION (Ghorer Bazar Style)
  - Desktop (> 1000px): Middle Bar + Dark Category Nav Bar (ONLY NAVLINK IS STICKY)
  - Tablet (800px - 1000px): Single Row: Hamburger | Logo | Search | Icons only
  - Mobile (< 800px): Hamburger | Logo | Cart + Search
  - Offcanvas Nav Drawer (Left)
  - Offcanvas Cart Drawer (Right Sidebar):
    * Opens on Cart click
    * Empty State ("No items in your cart!")
    * Filled State with item card, qty controller (- / +), calc (x price = total), remove (x)
    * "You May Also Like" cross-sell slider with "+ Add" button
    * Total price & Orange "CHECKOUT" button
  =============================================================================
{% endcomment %}

{% liquid
  assign main_menu = linklists[section.settings.menu]
  assign quick_menu = linklists[section.settings.quick_links_menu]
  assign nav_bg = section.settings.nav_bg_color | default: '#052724'
  assign nav_text = section.settings.nav_text_color | default: '#ffffff'
  assign accent_color = section.settings.accent_color | default: '#f37321'
  assign rec_collection = collections[section.settings.cart_rec_collection]
  if rec_collection == blank or rec_collection.products_count == 0
    assign rec_collection = collections['all']
  endif
  if rec_collection == blank or rec_collection.products_count == 0
    assign rec_collection = collections.first
  endif

  assign more_about_url = section.settings.more_about_us_url | default: '/pages/about-us'
  assign more_wishlist_url = section.settings.more_wishlist_url | default: section.settings.wishlist_url | default: '/pages/wishlist'
  assign more_faq_url = section.settings.more_faq_url | default: '/pages/faq'
  assign more_call_val = section.settings.more_phone_number | default: section.settings.phone_number | default: '+8809642922922'
  assign more_wa_val = section.settings.more_whatsapp_number | default: section.settings.whatsapp_number | default: '+8801321208940'
%}

<style>
  :root {
    --gh-nav-bg: {{ nav_bg }};
    --gh-nav-text: {{ nav_text }};
    --gh-accent: {{ accent_color }};
    --gh-accent-hover: #e06010;
    --gh-border-light: #ececec;
    --gh-text-dark: #222529;
    --gh-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .gh-custom-header {
    font-family: var(--gh-font);
    background: #ffffff;
    width: 100%;
    position: relative;
    z-index: 999;
    box-sizing: border-box;
  }

  .gh-custom-header *, .gh-custom-header *::before, .gh-custom-header *::after {
    box-sizing: border-box;
  }

  .gh-container {
    max-width: var(--container-max-width, 80%);
    margin: 0 auto;
    padding: 0 20px;
    width: 100%;
    box-sizing: border-box;
  }
  @media (max-width: 1600px) {
    .gh-container {
      max-width: 95%;
    }
  }
  @media (max-width: 479px) {
    .gh-container {
      max-width: 100%;
      padding: 0 12px;
    }
  }

  /* TOP / MIDDLE BAR */
  .gh-middle-bar {
    padding: 14px 0;
    background: #ffffff;
    border-bottom: 1px solid #f0f0f0;
    position: relative;
    z-index: 10;
  }

  .gh-middle-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .gh-left-group {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .gh-tablet-hamburger {
    display: none;
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
    color: var(--gh-text-dark);
  }

  .gh-tablet-hamburger svg { width: 22px; height: 22px; }

  .gh-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .gh-logo-img {
    height: auto;
    max-width: {{ section.settings.logo_width | default: 160 }}px;
    max-height: 52px;
    object-fit: contain;
    display: block;
  }

  .gh-search-form {
    flex: 1;
    max-width: 44.6rem;
    width: 100%;
    position: relative;
  }

  .gh-search-input-wrap {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .gh-search-input {
    width: 100%;
    height: 42px;
    background: #ffffff;
    border: 1px solid #d5d9df;
    border-radius: 8px;
    padding: 0 45px 0 16px;
    font-size: 14px;
    color: var(--gh-text-dark);
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .gh-search-input::-webkit-search-decoration,
  .gh-search-input::-webkit-search-cancel-button,
  .gh-search-input::-webkit-search-results-button,
  .gh-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none !important;
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .gh-search-input::-ms-clear,
  .gh-search-input::-ms-reveal {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
  }

  .gh-search-input:focus {
    background: #ffffff;
    border-color: var(--gh-accent, #f37321);
    box-shadow: 0 0 0 1px var(--gh-accent, #f37321);
  }

  .gh-search-btn {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #4b5563;
    border-radius: 50%;
    transition: color 0.15s ease;
  }

  .gh-search-btn:hover { color: var(--gh-accent, #f37321); }
  .gh-search-btn svg { width: 18px; height: 18px; }

  /* LIVE SEARCH DROPDOWN (Matches Screenshot_4.png) */
  .gh-live-search-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    width: 100%;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    max-height: 390px;
    overflow-y: auto;
    z-index: 1001;
    display: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
  }

  .gh-live-search-dropdown::-webkit-scrollbar {
    width: 6px;
  }
  .gh-live-search-dropdown::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
  }

  .gh-live-search-list {
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }

  .gh-search-result-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 16px;
    text-decoration: none;
    border-bottom: 1px solid #f1f3f5;
    transition: background-color 0.15s ease;
    cursor: pointer;
  }

  .gh-search-result-item:last-child {
    border-bottom: none;
  }

  .gh-search-result-item:hover,
  .gh-search-result-item.is-selected {
    background-color: #f8fafc;
  }

  .gh-search-item-img {
    width: 50px;
    height: 50px;
    min-width: 50px;
    border: 1px solid #edf0f2;
    border-radius: 6px;
    padding: 3px;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .gh-search-item-img img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .gh-search-item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gh-search-item-title {
    font-size: 13.5px;
    font-weight: 500;
    color: #1e293b;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gh-search-item-price {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--gh-accent, #f37321);
    line-height: 1.2;
  }

  .gh-search-item-vendor {
    font-size: 12px;
    color: #64748b;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gh-search-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 26px 16px;
    color: #64748b;
    font-size: 13px;
  }

  .gh-search-spinner {
    width: 20px;
    height: 20px;
    border: 2.5px solid rgba(243, 115, 33, 0.2);
    border-top-color: var(--gh-accent, #f37321);
    border-radius: 50%;
    animation: ghSearchSpin 0.6s linear infinite;
  }

  @keyframes ghSearchSpin {
    to { transform: rotate(360deg); }
  }

  .gh-search-no-results {
    padding: 26px 18px;
    text-align: center;
    color: #64748b;
    font-size: 13.5px;
  }

  .gh-search-no-results strong {
    color: #1e293b;
  }



  .gh-actions {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-shrink: 0;
  }

  .gh-action-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--gh-text-dark);
    position: relative;
    cursor: pointer;
    background: none;
    border: none;
    padding: 2px;
    transition: color 0.2s ease;
  }

  .gh-action-link:hover { color: var(--gh-accent); }

  .gh-icon-box {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
  }

  .gh-icon-box svg { width: 22px; height: 22px; }

  .gh-action-label {
    font-size: 11px;
    font-weight: 500;
    margin-top: 3px;
    white-space: nowrap;
    line-height: 1.2;
  }

  .gh-badge {
    position: absolute;
    top: -5px;
    right: -8px;
    background: var(--gh-accent);
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    min-width: 17px;
    height: 17px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    line-height: 1;
  }

  /* MORE DROPDOWN (Matches Screenshot_4.png & Fixes Hover Bug) */
  .gh-more-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .gh-more-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 6px;
    width: 200px;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border: 1px solid #edf0f3;
    padding: 0;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    overflow: visible;
  }

  /* Invisible hover bridge to eliminate gap between button and dropdown */
  .gh-more-dropdown::before {
    content: '';
    position: absolute;
    top: -14px;
    left: -10px;
    right: -10px;
    height: 16px;
    background: transparent;
  }

  .gh-more-wrap:hover .gh-more-dropdown,
  .gh-more-wrap:focus-within .gh-more-dropdown,
  .gh-more-wrap.is-open .gh-more-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .gh-more-item-wrap {
    position: relative;
  }

  .gh-more-item-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 16px;
    font-size: 13.5px;
    font-weight: 500;
    color: #334155;
    text-decoration: none;
    border-bottom: 1px solid #f1f3f5;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .gh-more-item-wrap:first-child > .gh-more-item-link {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }

  .gh-more-item-wrap:last-child > .gh-more-item-link {
    border-bottom: none;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }

  .gh-more-item-link:hover {
    background-color: #fffaf5;
    color: var(--gh-accent, #f37321);
  }

  .gh-more-item-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: #475569;
    transition: color 0.15s ease;
  }

  .gh-more-item-icon svg {
    width: 16px;
    height: 16px;
  }

  .gh-more-item-link:hover .gh-more-item-icon svg:not(.gh-whatsapp-icon) {
    color: var(--gh-accent, #f37321);
  }

  .gh-more-item-icon .gh-whatsapp-icon {
    color: #25D366;
  }

  .gh-more-item-text {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gh-more-item-arrow {
    width: 14px;
    height: 14px;
    color: #94a3b8;
    margin-left: auto;
  }

  /* Nested flyout for More menu items */
  .gh-more-nested-dropdown {
    position: absolute;
    top: 0;
    right: 100%;
    margin-right: 4px;
    width: 190px;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #edf0f3;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    overflow: hidden;
    z-index: 1002;
  }

  .gh-more-nested-dropdown::before {
    content: '';
    position: absolute;
    top: -5px;
    right: -10px;
    bottom: -5px;
    width: 12px;
    background: transparent;
  }

  .gh-more-item-wrap:hover > .gh-more-nested-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .gh-more-nested-link {
    display: block;
    padding: 9px 16px;
    font-size: 13px;
    color: #334155;
    text-decoration: none;
    border-bottom: 1px solid #f1f3f5;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .gh-more-nested-link:last-child {
    border-bottom: none;
  }

  .gh-more-nested-link:hover {
    background-color: #fffaf5;
    color: var(--gh-accent, #f37321);
  }

  .gh-more-empty-notice {
    padding: 16px 14px;
    font-size: 12.5px;
    color: #64748b;
    text-align: center;
  }

  /* NAVLINK BAR (Dark Green - STICKY ON DESKTOP > 1000px) */
  .gh-nav-bar-wrapper { width: 100%; position: relative; }
  .gh-nav-bar {
    background-color: var(--gh-nav-bg);
    width: 100%;
    position: relative;
    z-index: 5;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .gh-nav-bar.is-nav-sticky {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 9999;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
    animation: ghNavSlideDown 0.25s ease forwards;
  }

  @keyframes ghNavSlideDown {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  .gh-nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
  }

  .gh-nav-menu {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .gh-nav-item { position: relative; }
  .gh-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 14px 14px;
    color: var(--gh-nav-text);
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .gh-nav-link:hover { color: #ffb885; }
  .gh-chevron-down { width: 9px; height: 9px; transition: transform 0.2s ease; }
  .gh-nav-item:hover > .gh-nav-link .gh-chevron-down { transform: rotate(180deg); }

  .gh-submenu {
    position: absolute;
    top: 100%;
    left: 0;
    background: #ffffff;
    min-width: 210px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    border-radius: 6px;
    list-style: none;
    margin: 0;
    padding: 8px 0;
    display: none;
    z-index: 100;
    border: 1px solid #f0f0f0;
    animation: ghFadeDown 0.2s ease forwards;
  }

  .gh-nav-item:hover > .gh-submenu { display: block; }
  .gh-submenu-item a {
    display: block;
    padding: 9px 18px;
    font-size: 13px;
    color: #333;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .gh-submenu-item a:hover { background: #fdf5f0; color: var(--gh-accent); padding-left: 22px; }

  .gh-flash-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.12);
    padding: 6px 14px;
    border-radius: 20px;
    white-space: nowrap;
    margin-left: 15px;
    transition: background 0.2s ease;
  }
  .gh-flash-btn:hover { background: var(--gh-accent); }
  .gh-flash-btn svg { width: 14px; height: 14px; color: #ffc107; }

  /* MOBILE HEADER (< 800px) */
  .gh-header-mobile {
    display: none;
    background: #ffffff;
    padding: 12px 16px;
    border-bottom: 1px solid #eee;
  }
  .gh-mobile-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .gh-mobile-menu-btn {
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gh-text-dark);
  }
  .gh-mobile-menu-btn svg { width: 24px; height: 24px; }
  .gh-mobile-cart-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--gh-text-dark);
    position: relative;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .gh-mobile-cart-btn svg { width: 24px; height: 24px; }
  .gh-mobile-search-bar { display: none; padding: 8px 16px 12px; background: #ffffff; }

  /* OVERLAYS & DRAWERS */
  .gh-drawer-overlay, .gh-cart-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
    z-index: 99998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .gh-drawer-overlay.is-active, .gh-cart-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  /* LEFT NAV DRAWER */
  .gh-drawer {
    position: fixed;
    top: 0;
    left: 0;
    width: 320px;
    max-width: 86vw;
    height: 100%;
    background: #ffffff;
    z-index: 99999;
    transform: translateX(-100%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 4px 0 25px rgba(0, 0, 0, 0.18);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .gh-drawer.is-active { transform: translateX(0); }
  .gh-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    border-bottom: 1px solid #f0f0f0;
  }
  .gh-drawer-title { font-size: 15px; font-weight: 700; color: var(--gh-text-dark); }
  .gh-drawer-close { background: none; border: none; font-size: 20px; cursor: pointer; color: #666; }
  .gh-drawer-body { flex: 1; overflow-y: auto; padding: 16px; }

  .gh-user-card {
    background: linear-gradient(135deg, var(--gh-accent) 0%, #fa8c16 100%);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    color: #ffffff;
    margin-bottom: 18px;
    text-decoration: none;
  }
  .gh-user-avatar {
    width: 44px;
    height: 44px;
    background: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gh-accent);
  }
  .gh-user-avatar svg { width: 24px; height: 24px; }
  .gh-user-greeting { font-size: 15px; font-weight: 700; color: #ffffff; }
  .gh-user-subtext { font-size: 13px; color: rgba(255, 255, 255, 0.9); }

  .gh-drawer-card {
    background: #f8f9fa;
    border-radius: 12px;
    border: 1px solid #ebecee;
    overflow: hidden;
    margin-bottom: 24px;
  }
  .gh-drawer-menu { list-style: none; margin: 0; padding: 0; }
  .gh-drawer-item { border-bottom: 1px solid #f0f1f3; }
  .gh-drawer-link-row { display: flex; align-items: center; justify-content: space-between; }
  .gh-drawer-link { display: block; flex: 1; padding: 13px 16px; font-size: 14px; color: #2b2f33; text-decoration: none; font-weight: 500; }
  .gh-drawer-accordion-btn { background: none; border: none; padding: 13px 16px; cursor: pointer; color: #8c939d; }
  .gh-drawer-accordion-btn.is-open { transform: rotate(90deg); color: var(--gh-accent); }
  .gh-drawer-accordion-btn svg { width: 14px; height: 14px; }
  .gh-drawer-submenu { list-style: none; margin: 0; padding: 4px 0 8px 14px; display: none; background: #f2f4f7; }
