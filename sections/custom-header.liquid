</div>

<script>
  (function() {
    function initCustomHeader() {
      const header = document.getElementById('ghCustomHeader');
      const middleBar = document.getElementById('ghMiddleBar');
      const navWrapper = document.getElementById('ghNavBarWrapper');
      const navBar = document.getElementById('ghNavBar');
      
      const drawer = document.getElementById('ghDrawer');
      const drawerOverlay = document.getElementById('ghDrawerOverlay');
      const drawerCloseBtn = document.getElementById('ghDrawerClose');
      const drawerOpenBtns = document.querySelectorAll('.js-gh-drawer-open');
      const accordionBtns = document.querySelectorAll('.js-drawer-acc-btn');

      const cartDrawer = document.getElementById('ghCartDrawer');
      const cartOverlay = document.getElementById('ghCartOverlay');
      const cartCloseBtn = document.getElementById('ghCartCloseBtn');
      const cartOpenBtns = document.querySelectorAll('.js-gh-cart-open');
      const cartEmptyView = document.getElementById('ghCartEmptyView');
      const cartFilledContent = document.getElementById('ghCartFilledContent');
      const cartItemsList = document.getElementById('ghCartItemsList');
      const cartTotalVal = document.getElementById('ghCartTotalVal');
      const badgeCounts = document.querySelectorAll('.js-cart-badge-count');

      const recSlider = document.getElementById('ghRecSlider');
      const recPrev = document.getElementById('ghRecPrev');
      const recNext = document.getElementById('ghRecNext');

      const moreWrap = document.querySelector('.gh-more-wrap');
      const moreBtn = document.querySelector('.gh-more-btn');

      if (!header) return;

      /* Desktop Navlink Sticky Scroll (> 1000px only) */
      if (navBar && navWrapper) {
        let isSticky = false;
        let ticking = false;

        function updateNavSticky() {
          const isDesktop = window.innerWidth > 1000;
          if (!isDesktop) {
            if (isSticky) {
              navBar.classList.remove('is-nav-sticky');
              navWrapper.style.height = '';
              isSticky = false;
            }
            ticking = false;
            return;
          }

          const triggerPoint = middleBar ? middleBar.offsetHeight : 80;
          const currentScroll = window.scrollY || window.pageYOffset;

          if (currentScroll > triggerPoint) {
            if (!isSticky) {
              navWrapper.style.height = navBar.offsetHeight + 'px';
              navBar.classList.add('is-nav-sticky');
              isSticky = true;
            }
          } else {
            if (isSticky) {
              navBar.classList.remove('is-nav-sticky');
              navWrapper.style.height = '';
              isSticky = false;
            }
          }
          ticking = false;
        }

        window.addEventListener('scroll', function() {
          if (!ticking) {
            window.requestAnimationFrame(updateNavSticky);
            ticking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', updateNavSticky);
        updateNavSticky();
      }

      /* Desktop More Button Dropdown (Does NOT open drawer) */
      if (moreBtn && moreWrap) {
        moreBtn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = moreWrap.classList.toggle('is-open');
          moreBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
        document.addEventListener('click', function(e) {
          if (!e.target.closest('.gh-more-wrap')) {
            moreWrap.classList.remove('is-open');
            moreBtn.setAttribute('aria-expanded', 'false');
          }
        });
        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && moreWrap.classList.contains('is-open')) {
            moreWrap.classList.remove('is-open');
            moreBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      /* Live / Predictive Search (>= 2 chars, debounced, cancel stale, loading, no-results) */
      function initLiveSearch() {
        const searchForms = document.querySelectorAll('.gh-search-form');
        if (!searchForms.length) return;

        searchForms.forEach(form => {
          const input = form.querySelector('.gh-search-input');
          const dropdown = form.querySelector('.gh-live-search-dropdown');
          if (!input || !dropdown) return;

          let debounceTimer = null;
          let activeAbortController = null;
          let selectedIndex = -1;
          const searchCache = {};

          function formatPrice(val) {
            if (val === undefined || val === null || val === '') return '';
            let num = Number(val);
            if (isNaN(num)) return String(val);
            if (typeof val === 'string' && val.includes('.')) {
              num = parseFloat(val);
            } else if (num > 10000 && !String(val).includes('.')) {
              num = num / 100;
            }
            const rounded = Math.round(num).toLocaleString('en-US');
            return '৳' + rounded;
          }

          function getThumbUrl(url) {
            if (!url) return 'https://backoffice.ghorerbazar.com/company_logo/qJaKf1768887846.png';
            if (url.startsWith('//')) url = 'https:' + url;
            if (url.includes('{width}')) return url.replace('{width}', '100');
            if (url.includes('?')) return url + '&width=100';
            return url + '?width=100';
          }

          function openDropdown() {
            dropdown.style.display = 'block';
            dropdown.setAttribute('aria-expanded', 'true');
          }

          function closeDropdown() {
            dropdown.style.display = 'none';
            dropdown.setAttribute('aria-expanded', 'false');
            selectedIndex = -1;
          }

          function renderLoading() {
            dropdown.innerHTML = `
              <div class="gh-search-loading">
                <div class="gh-search-spinner"></div>
                <span>Searching products...</span>
              </div>
            `;
            openDropdown();
          }

          function renderNoResults(term) {
            dropdown.innerHTML = `
              <div class="gh-search-no-results">
                No products found for "<strong>${escapeHtml(term)}</strong>"
              </div>
            `;
            openDropdown();
          }

          function renderResults(products, term) {
            if (!products || products.length === 0) {
              renderNoResults(term);
              return;
            }

            let html = '<div class="gh-live-search-list" role="listbox">';
            products.forEach((prod, idx) => {
              const pTitle = prod.title || '';
              const pUrl = prod.url || '#';
              const pPrice = prod.price !== undefined ? formatPrice(prod.price) : (prod.price_min !== undefined ? formatPrice(prod.price_min) : '');
              const pVendor = prod.vendor || '';
              const pImg = getThumbUrl((prod.featured_image && prod.featured_image.url) ? prod.featured_image.url : (prod.image || ''));

              html += `
                <a href="${pUrl}" class="gh-search-result-item" role="option" data-index="${idx}">
                  <div class="gh-search-item-img">
                    <img src="${pImg}" alt="${escapeHtml(pTitle)}" loading="lazy">
                  </div>
                  <div class="gh-search-item-info">
                    <span class="gh-search-item-title">${escapeHtml(pTitle)}</span>
                    ${pPrice ? `<span class="gh-search-item-price">${pPrice}</span>` : ''}
                    ${pVendor ? `<span class="gh-search-item-vendor">${escapeHtml(pVendor)}</span>` : ''}
                  </div>
                </a>
              `;
            });
            html += '</div>';

            dropdown.innerHTML = html;
            openDropdown();
            selectedIndex = -1;
          }

          function fetchResults(term) {
            const cacheKey = term.toLowerCase().trim();
            if (searchCache[cacheKey]) {
              renderResults(searchCache[cacheKey], term);
              return;
            }

            renderLoading();

            if (activeAbortController) {
              activeAbortController.abort();
            }
            activeAbortController = new AbortController();

            const suggestUrl = `/search/suggest.json?q=${encodeURIComponent(term)}&resources[type]=product&resources[limit]=8&resources[options][unavailable_products]=last`;

            fetch(suggestUrl, { signal: activeAbortController.signal })
              .then(res => {
                if (!res.ok) throw new Error('Search request failed');
                return res.json();
              })
              .then(data => {
                const products = (data && data.resources && data.resources.results && data.resources.results.products) ? data.resources.results.products : [];
                searchCache[cacheKey] = products;
                renderResults(products, term);
              })
              .catch(err => {
                if (err.name === 'AbortError') return;
                // Fallback to /search.js?q=...&type=product
                fetch(`/search.js?q=${encodeURIComponent(term)}&type=product`, { signal: activeAbortController?.signal })
                  .then(r => r.json())
                  .then(data => {
                    const fallbackProducts = (data && data.results) ? data.results : [];
                    searchCache[cacheKey] = fallbackProducts;
                    renderResults(fallbackProducts, term);
                  })
                  .catch(fallbackErr => {
                    if (fallbackErr.name === 'AbortError') return;
                    renderNoResults(term);
                  });
              });
          }

          input.addEventListener('input', function() {
            const val = input.value.trim();
            if (debounceTimer) clearTimeout(debounceTimer);

            if (val.length < 2) {
              if (activeAbortController) activeAbortController.abort();
              closeDropdown();
              return;
            }

            debounceTimer = setTimeout(() => {
              fetchResults(val);
            }, 220);
          });

          input.addEventListener('focus', function() {
            const val = input.value.trim();
            if (val.length >= 2) {
              if (searchCache[val.toLowerCase()]) {
                renderResults(searchCache[val.toLowerCase()], val);
              } else {
                fetchResults(val);
              }
            }
          });

          input.addEventListener('keydown', function(e) {
            const items = dropdown.querySelectorAll('.gh-search-result-item');
            if (!items.length || dropdown.style.display === 'none') return;

            if (e.key === 'ArrowDown') {
              e.preventDefault();
              selectedIndex = (selectedIndex + 1) % items.length;
              updateSelectedItem(items);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              selectedIndex = (selectedIndex - 1 + items.length) % items.length;
              updateSelectedItem(items);
            } else if (e.key === 'Enter') {
              if (selectedIndex >= 0 && items[selectedIndex]) {
                e.preventDefault();
                items[selectedIndex].click();
              }
            } else if (e.key === 'Escape') {
              closeDropdown();
            }
          });

          function updateSelectedItem(items) {
            items.forEach((item, idx) => {
              if (idx === selectedIndex) {
                item.classList.add('is-selected');
                item.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
              } else {
                item.classList.remove('is-selected');
              }
            });
          }

          document.addEventListener('click', function(e) {
            if (!form.contains(e.target)) {
              closeDropdown();
            }
          });
        });
      }

      initLiveSearch();

      /* Left Nav Drawer */
      function openNavDrawer() {
        closeCartDrawer();
        if (drawer && drawerOverlay) {
          drawer.classList.add('is-active');
          drawerOverlay.classList.add('is-active');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeNavDrawer() {
        if (drawer && drawerOverlay) {
          drawer.classList.remove('is-active');
          drawerOverlay.classList.remove('is-active');
          if (!cartDrawer || !cartDrawer.classList.contains('is-active')) {
            document.body.style.overflow = '';
          }
        }
      }

      drawerOpenBtns.forEach(btn => btn.addEventListener('click', e => {
        e.preventDefault();
        openNavDrawer();
      }));
      if (drawerCloseBtn) drawerCloseBtn.addEventListener('click', closeNavDrawer);
      if (drawerOverlay) drawerOverlay.addEventListener('click', closeNavDrawer);

      /* Right Cart Drawer */
      function openCartDrawer() {
        closeNavDrawer();
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.add('is-active');
          cartOverlay.classList.add('is-active');
          document.body.style.overflow = 'hidden';
          // Always refresh cart data live on opening
          window.refreshGhorerCart(false);
        }
      }

      function closeCartDrawer() {
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.remove('is-active');
          cartOverlay.classList.remove('is-active');
          if (!drawer || !drawer.classList.contains('is-active')) {
            document.body.style.overflow = '';
          }
        }
      }

      cartOpenBtns.forEach(btn => btn.addEventListener('click', function(e) {
        e.preventDefault();
        openCartDrawer();
      }));
      if (cartCloseBtn) cartCloseBtn.addEventListener('click', closeCartDrawer);
      if (cartOverlay) cartOverlay.addEventListener('click', closeCartDrawer);

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
          closeNavDrawer();
          closeCartDrawer();
        }
      });

      /* Accordion */
      accordionBtns.forEach(btn => {
        btn.addEventListener('click', e => {
          e.preventDefault();
          e.stopPropagation();
          const parentRow = btn.closest('.gh-drawer-item');
          const submenu = parentRow ? parentRow.querySelector('.gh-drawer-submenu') : null;
