      </div>
    </div>

    <!-- Next Button -->
    <button type="button" class="gh-cat-arrow-btn next" id="ghCatNext-{{ section.id }}" aria-label="Next Category">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

  </div>
</div>

<script>
  (function() {
    function initCatSlider() {
      const container = document.getElementById('ghCatContainer-{{ section.id }}');
      const viewport = document.getElementById('ghCatViewport-{{ section.id }}');
      const track = document.getElementById('ghCatTrack-{{ section.id }}');
      const prevBtn = document.getElementById('ghCatPrev-{{ section.id }}');
      const nextBtn = document.getElementById('ghCatNext-{{ section.id }}');

      if (!viewport || !track) return;

      const slides = track.querySelectorAll('.gh-cat-slide');
      const totalSlides = slides.length;
      if (totalSlides === 0) return;

      let autoplayTimer = null;
      const autoplayEnabled = {{ autoplay | json }};
      const autoplaySpeed = {{ autoplay_speed }};

      function getStepSize() {
        if (slides.length <= 1) return 0;
        const s0 = slides[0].getBoundingClientRect();
        const s1 = slides[1].getBoundingClientRect();
        return s1.left - s0.left;
      }

      function getMaxTranslate() {
        const totalTrackWidth = track.scrollWidth;
        const viewportWidth = viewport.offsetWidth;
        return Math.max(0, totalTrackWidth - viewportWidth);
      }

      function getScrollStepCount() {
        const w = window.innerWidth;
        if (w <= 575) return 1;
        if (w <= 991) return 2;
        return 3;
      }

      let currentTranslate = 0;

      function updateArrows() {
        const maxTrans = getMaxTranslate();
        if (maxTrans <= 0) {
          if (prevBtn) prevBtn.classList.add('is-disabled');
          if (nextBtn) nextBtn.classList.add('is-disabled');
          return;
        }
        if (prevBtn) {
          if (currentTranslate <= 2) prevBtn.classList.add('is-disabled');
          else prevBtn.classList.remove('is-disabled');
        }
        if (nextBtn) {
          if (currentTranslate >= maxTrans - 2) nextBtn.classList.add('is-disabled');
          else nextBtn.classList.remove('is-disabled');
        }
      }

      function scrollToTranslate(target, smooth) {
        const maxTrans = getMaxTranslate();
        currentTranslate = Math.max(0, Math.min(target, maxTrans));
        track.style.transition = smooth ? 'transform 0.4s cubic-bezier(0.25, 1, 0.5, 1)' : 'none';
        track.style.transform = `translateX(-${currentTranslate}px)`;
        updateArrows();
      }

      function scrollNext() {
        const step = getStepSize();
        const maxTrans = getMaxTranslate();
        const count = getScrollStepCount();
        if (currentTranslate >= maxTrans - 2) {
          scrollToTranslate(0, true);
        } else {
          scrollToTranslate(currentTranslate + (step * count), true);
        }
      }

      function scrollPrev() {
        const step = getStepSize();
        const maxTrans = getMaxTranslate();
        const count = getScrollStepCount();
        if (currentTranslate <= 2) {
          scrollToTranslate(maxTrans, true);
        } else {
          scrollToTranslate(currentTranslate - (step * count), true);
        }
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          scrollNext();
          resetAutoplay();
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          scrollPrev();
          resetAutoplay();
        });
      }

      // Autoplay
      function startAutoplay() {
        if (!autoplayEnabled) return;
        stopAutoplay();
        autoplayTimer = setInterval(scrollNext, autoplaySpeed);
      }

      function stopAutoplay() {
        if (autoplayTimer) {
          clearInterval(autoplayTimer);
          autoplayTimer = null;
        }
      }

      function resetAutoplay() {
        stopAutoplay();
        startAutoplay();
      }

      viewport.addEventListener('mouseenter', stopAutoplay);
      viewport.addEventListener('mouseleave', startAutoplay);

      // =======================================================================
      // DRAG & SWIPE SUPPORT (MOUSE DRAG + TOUCH SWIPE)
      // =======================================================================
      let isDragging = false;
      let startX = 0;
      let dragStartTranslate = 0;
      let diffX = 0;
      let isMoved = false;

      /* FIX: raised the "moved" threshold from 6px to 12px.
         6px was too sensitive - normal hand tremor while clicking a
         card was being registered as a drag, which caused the click
         handler below to call preventDefault() and block navigation
         into the collection. 12px reliably distinguishes a real swipe
         from a click/tap. */
      const MOVE_THRESHOLD = 12;

      // Prevent native browser link and image ghost dragging
      viewport.addEventListener('dragstart', e => e.preventDefault());
      track.addEventListener('dragstart', e => e.preventDefault());

      function onPointerDown(e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        if (e.target.closest('.gh-cat-arrow-btn')) return;

        isDragging = true;
        isMoved = false;
        startX = e.clientX;
        dragStartTranslate = currentTranslate;
        diffX = 0;

        stopAutoplay();
        track.style.transition = 'none';
        viewport.classList.add('is-dragging');

        /* FIX: removed viewport.setPointerCapture() here.
           Capturing the pointer on the viewport was redirecting the
           resulting "click" event's target away from the card <a>
           tag in some browsers, which stopped the browser's default
           navigation action from firing - i.e. clicking a card never
           opened the collection. We already listen on window for
           pointermove/pointerup, so capture isn't needed at all. */

        window.addEventListener('pointermove', onPointerMove);
        window.addEventListener('pointerup', onPointerUp);
        window.addEventListener('pointercancel', onPointerUp);
      }

      function onPointerMove(e) {
        if (!isDragging) return;
        diffX = e.clientX - startX;

        if (Math.abs(diffX) > MOVE_THRESHOLD) {
          isMoved = true;
        }

        const maxTrans = getMaxTranslate();
        let target = dragStartTranslate - diffX;

        // Rubber-band resistance
        if (target < 0) {
          target = target * 0.3;
        } else if (target > maxTrans) {
          target = maxTrans + (target - maxTrans) * 0.3;
        }

        track.style.transform = `translateX(-${target}px)`;
      }

      function onPointerUp(e) {
        if (!isDragging) return;
        isDragging = false;
        viewport.classList.remove('is-dragging');

        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('pointerup', onPointerUp);
        window.removeEventListener('pointercancel', onPointerUp);

        const step = getStepSize();
        let targetTranslate = dragStartTranslate;

        if (step > 0) {
          if (diffX < -30) {
            // Dragged left -> Advance forward by at least 1 card
            const count = Math.max(1, Math.round(Math.abs(diffX) / step));
            targetTranslate = dragStartTranslate + (count * step);
          } else if (diffX > 30) {
            // Dragged right -> Go backward by at least 1 card
            const count = Math.max(1, Math.round(diffX / step));
            targetTranslate = dragStartTranslate - (count * step);
          } else {
            // Slight drag under 30px -> Snap back to nearest
            targetTranslate = Math.round((dragStartTranslate - diffX) / step) * step;
          }
        }

        scrollToTranslate(targetTranslate, true);
        diffX = 0;
        startAutoplay();
      }

      viewport.addEventListener('pointerdown', onPointerDown);

      // Prevent link navigation only when an actual drag occurred
      track.addEventListener('click', e => {
        if (isMoved) {
          e.preventDefault();
          e.stopPropagation();
          setTimeout(() => { isMoved = false; }, 60);
        }
      }, true);

      // Re-align on window resize
      window.addEventListener('resize', () => {
        const step = getStepSize();
        const maxTrans = getMaxTranslate();
        if (step > 0) {
          currentTranslate = Math.min(Math.round(currentTranslate / step) * step, maxTrans);
        } else {
          currentTranslate = 0;
        }
        scrollToTranslate(currentTranslate, false);
      });

      updateArrows();
      startAutoplay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCatSlider);
    } else {
      initCatSlider();
    }
  })();
</script>

