{% comment %}
  =============================================================================
  SELF-CONTAINED PRODUCT CARD SNIPPET (STANDALONE CSS + JS + LIVE AJAX CART)
  - File: snippets/product-card.liquid
  - Usage: {% render 'product-card', product: product, custom_badge: 'New Arrival' %}
  - Completely isolated: Has its own scoped styles & event handlers
  - Morphing Button: "Add To Cart" transforms into "[-] [qty] [+]" selector
  - Live Cart Sync: Increases/decreases live in Shopify cart (/cart/change.js)
  - Event Dispatch: Fires 'cart:updated' event for header and cart drawer sync
  =============================================================================
{% endcomment %}

{% liquid
  if product != blank
    assign p_id = product.id
    assign p_handle = product.handle
    assign p_variant_id = product.selected_or_first_available_variant.id
    assign p_title = product.title
    assign p_url = product.url
    assign p_price = product.price | money
    assign p_compare_price = product.compare_at_price | money
    assign p_img = product.featured_image
    assign is_on_sale = false
    if product.compare_at_price > product.price
      assign is_on_sale = true
    endif
    assign has_new_tag = false
    for tag in product.tags
      assign down_tag = tag | downcase
      if down_tag contains 'new'
        assign has_new_tag = true
        break
      endif
    endfor
  else
    # Fallback demo product
    assign p_id = demo_id | default: 'demo-p-1'
    assign p_handle = demo_handle | default: 'demo-product'
    assign p_variant_id = demo_variant_id | default: 'demo-v-1'
    assign p_title = demo_title | default: 'Black Seed Honey 500g'
    assign p_url = demo_url | default: '/collections/all'
    assign p_price = demo_price | default: '৳800'
    assign p_compare_price = demo_compare_price
    assign p_img = demo_img | default: 'https://backoffice.ghorerbazar.com/category_images/KbWCe1774766391.png'
    assign is_on_sale = false
    assign has_new_tag = demo_is_new | default: false
  endif

  assign badge_label = custom_badge
  if badge_label == blank and has_new_tag
    assign badge_label = settings.badge_new_label | default: 'New Arrival'
  endif

  if p_img.src
    assign p_img_url = p_img | image_url: width: 400
  else
    assign p_img_url = p_img
  endif
%}

<div class="gh-product-card js-gh-product-card" data-product-id="{{ p_id }}" data-variant-id="{{ p_variant_id }}" data-product-handle="{{ p_handle }}">
  
  <!-- Top Left Badge (New Arrival / Sale) -->
  {% if badge_label != blank %}
    <span class="gh-pcard-badge">{{ badge_label }}</span>
  {% elsif is_on_sale %}
    <span class="gh-pcard-badge gh-pcard-badge-sale">Sale</span>
  {% endif %}

  <!-- Top Right Wishlist Button -->
  <button type="button" 
    class="gh-pcard-wishlist-btn js-pcard-wishlist-btn" 
    aria-label="Add to Wishlist" 
    title="Add to Wishlist"
    data-product-id="{{ p_id }}"
    data-product-handle="{{ p_handle }}"
    data-variant-id="{{ p_variant_id }}"
    data-title="{{ p_title | escape }}"
    data-url="{{ p_url }}"
    data-price="{{ p_price }}"
    data-compare-price="{{ p_compare_price }}"
    data-image="{{ p_img_url }}"
    data-badge="{{ badge_label | escape }}"
    data-sale="{% if is_on_sale %}true{% else %}false{% endif %}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
  </button>

  <!-- Product Image Container with Hover Zoom -->
  <a href="{{ p_url }}" class="gh-pcard-img-wrap">
    {% if p_img.src %}
      <img src="{{ p_img | image_url: width: 400 }}" alt="{{ p_title | escape }}" class="gh-pcard-img" loading="lazy">
    {% else %}
      <img src="{{ p_img }}" alt="{{ p_title | escape }}" class="gh-pcard-img" loading="lazy">
    {% endif %}
  </a>

  <!-- Product Info -->
  <div class="gh-pcard-details">
    <a href="{{ p_url }}" class="gh-pcard-title" title="{{ p_title | escape }}">
      {{ p_title }}
    </a>

    <div class="gh-pcard-price">
      <span class="gh-pcard-price-current">{{ p_price }}</span>
      {% if is_on_sale and p_compare_price != blank %}
        <span class="gh-pcard-price-compare">{{ p_compare_price }}</span>
      {% endif %}
    </div>

    <!-- Actions: Add to Cart & Morphing Quantity Box -->
    <div class="gh-pcard-actions">
      <!-- 1. Add To Cart Button -->
      <button type="button" class="gh-pcard-btn-add js-pcard-add-btn" data-variant-id="{{ p_variant_id }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span>{{ settings.add_to_cart_text | default: 'Add To Cart' }}</span>
      </button>

      <!-- 2. Quantity Box (Morphs from Add To Cart) -->
      <div class="gh-pcard-qty-box js-pcard-qty-box" data-variant-id="{{ p_variant_id }}">
        <button type="button" class="gh-pcard-qty-btn js-pcard-qty-minus" aria-label="Decrease">&minus;</button>
        <span class="gh-pcard-qty-val js-pcard-qty-val">1</span>
        <button type="button" class="gh-pcard-qty-btn js-pcard-qty-plus" aria-label="Increase">&plus;</button>
      </div>
    </div>
  </div>
</div>

{% comment %}
  =============================================================================
  SELF-CONTAINED STYLES & SCRIPT
  =============================================================================
{% endcomment %}
<style>
  /* Standalone Product Card Styles */
  .gh-product-card {
    background: #ffffff;
    border: 1px solid #edf0f3;
    border-radius: 12px;
    padding: 16px 14px 16px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    width: 100%;
    box-sizing: border-box;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    user-select: none;
    -webkit-user-select: none;
    transform: none !important;
  }

  .gh-product-card * {
    box-sizing: border-box;
  }

  .gh-product-card:hover {
    border-color: #e2e8f0;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    transform: none !important;
  }

  /* Badge */
  .gh-pcard-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #f37321;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    z-index: 3;
    line-height: 1.2;
    box-shadow: 0 2px 5px rgba(243, 115, 33, 0.25);
    pointer-events: none;
  }

  .gh-pcard-badge-sale {
    background: #e53935;
    box-shadow: 0 2px 5px rgba(229, 57, 53, 0.25);
  }

  /* Wishlist Button (Top-Right) */
  .gh-pcard-wishlist-btn {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #edf0f3;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
    padding: 0;
    outline: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
    color: #6b7280;
  }

  .gh-pcard-wishlist-btn:hover {
    transform: scale(1.12);
    border-color: #f37321;
    color: #f37321;
    box-shadow: 0 4px 10px rgba(243, 115, 33, 0.15);
  }

  .gh-pcard-wishlist-btn:active {
    transform: scale(0.92);
  }

  .gh-pcard-wishlist-btn svg {
    width: 16px;
    height: 16px;
    stroke: currentColor;
    fill: transparent;
    transition: stroke 0.2s ease, fill 0.2s ease, transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    pointer-events: none;
  }

  .gh-pcard-wishlist-btn.is-active {
    color: #e53935;
    border-color: #ffdcd8;
    background: #fff8f8;
  }

  .gh-pcard-wishlist-btn.is-active svg {
    fill: #e53935;
    stroke: #e53935;
    animation: ghHeartPop 0.35s ease forwards;
  }

  @keyframes ghHeartPop {
    0% { transform: scale(1); }
    50% { transform: scale(1.28); }
    100% { transform: scale(1); }
  }

  /* Image Box */
  .gh-pcard-img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 12px;
    text-decoration: none;
    -webkit-user-drag: none;
    position: relative;
  }

  .gh-pcard-img {
    max-width: 85%;
    max-height: 85%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    transition: transform 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .gh-product-card:hover .gh-pcard-img {
    transform: scale(1.07);
  }

  /* Info Details */
  .gh-pcard-details {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
  }

  .gh-pcard-title {
    font-size: 14.5px;
    font-weight: 600;
    color: #1f2937;
    margin: 0 0 6px 0;
    text-decoration: none;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 38px;
    word-break: break-word;
    transition: color 0.2s ease;
  }

  .gh-pcard-title:hover {
    color: #f37321;
  }

  .gh-pcard-price {
    font-size: 16.5px;
    font-weight: 700;
    color: #f37321;
    margin: 0 0 12px 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .gh-pcard-price-compare {
    font-size: 13px;
    font-weight: 500;
    color: #9ca3af;
    text-decoration: line-through;
  }

  /* Actions */
  .gh-pcard-actions {
    width: 100%;
    margin-top: auto;
  }

  .gh-pcard-btn-add {
    width: 100%;
    height: 38px;
    background: #ffffff;
    border: 1.5px solid #f37321;
    color: #f37321;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
    outline: none;
    white-space: nowrap;
    padding: 0 10px;
  }

  .gh-pcard-btn-add svg {
    width: 15px;
    height: 15px;
    stroke: currentColor;
    stroke-width: 2.2;
    transition: stroke 0.25s ease;
  }

  .gh-pcard-btn-add:hover,
  .gh-product-card:hover .gh-pcard-btn-add {
    background: #f37321;
    color: #ffffff;
    border-color: #f37321;
  }

  .gh-pcard-btn-add:hover svg,
  .gh-product-card:hover .gh-pcard-btn-add svg {
    stroke: #ffffff;
  }

  .gh-pcard-btn-add:active {
    transform: scale(0.97);
  }

  /* Quantity Box */
  .gh-pcard-qty-box {
    display: none;
    align-items: stretch;
    border: 1.5px solid #f37321;
    border-radius: 6px;
    overflow: hidden;
    height: 38px;
    width: 100%;
    background: #ffffff;
  }

  .gh-pcard-qty-box.is-active {
    display: inline-flex;
  }

  .gh-pcard-qty-btn {
    background: #f37321;
    color: #ffffff;
    border: none;
    width: 36px;
    font-size: 17px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.15s;
    outline: none;
    user-select: none;
    padding: 0;
  }

  .gh-pcard-qty-btn:hover {
    background: #e06110;
  }

  .gh-pcard-qty-btn:active {
    background: #c9540b;
  }

  .gh-pcard-qty-btn:disabled,
  .gh-pcard-qty-btn.is-disabled {
    opacity: 0.4;
    cursor: not-allowed !important;
    pointer-events: none;
    background: #f37321;
  }

  .gh-pcard-qty-box.is-syncing .gh-pcard-qty-val {
    opacity: 0.65;
    transition: opacity 0.15s ease;
  }

  /* Locked State & Localized Mini Spinner (Zero layout shift, no full screen blocking) */
  .gh-pcard-qty-box.is-locked {
    position: relative;
    pointer-events: none;
  }
  .gh-pcard-qty-box.is-locked .gh-pcard-qty-btn {
    opacity: 0.35;
    cursor: not-allowed !important;
    pointer-events: none;
  }
  .gh-pcard-qty-box.is-locked .gh-pcard-qty-val {
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }
  .gh-pcard-qty-box.is-locked::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 13px;
    height: 13px;
    margin: -6.5px 0 0 -6.5px;
    border: 2px solid rgba(243, 115, 33, 0.25);
    border-top-color: #f37321;
    border-radius: 50%;
    animation: ghMiniSpin 0.6s linear infinite;
    pointer-events: none;
    z-index: 2;
  }
  @keyframes ghMiniSpin {
    to { transform: rotate(360deg); }
  }

  .gh-pcard-qty-val {
    flex: 1;
    text-align: center;
    border: none;
    outline: none;
    font-size: 14.5px;
    font-weight: 700;
    color: #1f2937;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  /* Responsive Card scaling */
  @media (max-width: 640px) {
    .gh-product-card {
      padding: 12px 9px 12px;
      border-radius: 10px;
    }
    .gh-pcard-badge {
      top: 8px;
      left: 8px;
      font-size: 9px;
      padding: 2px 6px;
    }
    .gh-pcard-wishlist-btn {
      top: 8px;
      right: 8px;
      width: 28px;
      height: 28px;
    }
    .gh-pcard-wishlist-btn svg {
      width: 14px;
      height: 14px;
    }
    .gh-pcard-img-wrap {
      margin-bottom: 8px;
    }
    .gh-pcard-title {
      font-size: 13px;
      min-height: 34px;
      margin-bottom: 4px;
    }
    .gh-pcard-price {
      font-size: 15px;
      margin-bottom: 8px;
    }
    .gh-pcard-btn-add,
    .gh-pcard-qty-box {
      height: 33px;
      font-size: 12px;
    }
    .gh-pcard-qty-btn {
      width: 32px;
    }
  }
</style>

<script>
  if (!window._ghProductCardScriptLoaded) {
    window._ghProductCardScriptLoaded = true;

    // Helper: Update Header badges
    function updateCardHeaderBadge(count) {
      document.querySelectorAll('.js-cart-badge-count').forEach(b => {
        b.textContent = count;
      });
    }

    // Global Product Cards Synchronizer (fallback definition if header not yet loaded)
    if (!window.syncAllProductCards) {
      window.syncAllProductCards = function(cart) {
        if (!cart || !Array.isArray(cart.items)) {
          return fetch('/cart.js')
            .then(res => res.json())
            .then(c => {
              if (c) window.syncAllProductCards(c);
              return c;
            })
            .catch(() => {});
        }

        const itemsMap = {};
        let totalCount = 0;
        cart.items.forEach(item => {
          const vid = String(item.variant_id || item.id || '');
          if (vid) {
            itemsMap[vid] = (itemsMap[vid] || 0) + Number(item.quantity || 0);
          }
          totalCount += Number(item.quantity || 0);
        });

        const badgeCount = cart.item_count !== undefined ? cart.item_count : totalCount;
        updateCardHeaderBadge(badgeCount);

        // 1. Snippet product cards (.js-gh-product-card)
        document.querySelectorAll('.js-gh-product-card').forEach(card => {
          const variantId = String(card.dataset.variantId || '');
          if (card.querySelector('.js-pcard-qty-box.is-locked')) return;

          const addBtn = card.querySelector('.js-pcard-add-btn');
          const qtyBox = card.querySelector('.js-pcard-qty-box');
          const qtyVal = card.querySelector('.js-pcard-qty-val');
          const plusBtn = card.querySelector('.js-pcard-qty-plus');
          const currentQty = itemsMap[variantId] || 0;

          if (currentQty > 0) {
            if (addBtn) addBtn.style.display = 'none';
            if (qtyBox) qtyBox.classList.add('is-active');
            if (qtyVal) qtyVal.textContent = currentQty;
          } else {
            if (addBtn) addBtn.style.display = '';
            if (qtyBox) qtyBox.classList.remove('is-active');
            if (qtyVal) qtyVal.textContent = '1';
          }

          if (plusBtn) {
            if (currentQty >= 20) {
              plusBtn.disabled = true;
              plusBtn.classList.add('is-disabled');
              plusBtn.setAttribute('aria-disabled', 'true');
            } else {
              plusBtn.disabled = false;
              plusBtn.classList.remove('is-disabled');
              plusBtn.removeAttribute('aria-disabled');
            }
          }
        });

        // 2. Top-selling cards (.gh-top-card)
        document.querySelectorAll('.gh-top-card').forEach(card => {
          const variantId = String(card.dataset.variantId || '');
          if (card.querySelector('.js-gh-qty-box.is-locked')) return;

          const addBtn = card.querySelector('.js-gh-add-cart');
          const qtyBox = card.querySelector('.js-gh-qty-box');
          const qtyVal = card.querySelector('.js-gh-qty-val');
          const plusBtn = card.querySelector('.js-gh-qty-plus');
          const currentQty = itemsMap[variantId] || 0;

          if (currentQty > 0) {
            if (addBtn) addBtn.style.display = 'none';
            if (qtyBox) qtyBox.classList.add('is-active');
            if (qtyVal) qtyVal.textContent = currentQty;
          } else {
            if (addBtn) addBtn.style.display = '';
            if (qtyBox) qtyBox.classList.remove('is-active');
            if (qtyVal) qtyVal.textContent = '1';
          }

          if (plusBtn) {
            if (currentQty >= 20) {
              plusBtn.disabled = true;
              plusBtn.classList.add('is-disabled');
              plusBtn.setAttribute('aria-disabled', 'true');
            } else {
              plusBtn.disabled = false;
              plusBtn.classList.remove('is-disabled');
              plusBtn.removeAttribute('aria-disabled');
            }
          }
        });

        return Promise.resolve(cart);
      };
      window.syncGhProductCardsWithCart = window.syncAllProductCards;
    }

    // Attach Event Handlers (Idempotent per card)
    window.initGhProductCards = function() {
      document.querySelectorAll('.js-gh-product-card:not([data-initialized])').forEach(card => {
        card.setAttribute('data-initialized', 'true');
        const variantId = String(card.dataset.variantId || '');
        const addBtn = card.querySelector('.js-pcard-add-btn');
        const qtyBox = card.querySelector('.js-pcard-qty-box');
        const qtyVal = card.querySelector('.js-pcard-qty-val');
        const plusBtn = card.querySelector('.js-pcard-qty-plus');
        const minusBtn = card.querySelector('.js-pcard-qty-minus');

        // 1. ADD TO CART
        if (addBtn) {
          addBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!variantId) return;
            const qBox = card.querySelector('.js-pcard-qty-box');
            if (qBox && qBox.classList.contains('is-locked')) return;

            let curQty = 0;
            const qV = card.querySelector('.js-pcard-qty-val');
            if (qBox && qBox.classList.contains('is-active') && qV) {
              curQty = parseInt(qV.textContent, 10) || 0;
            }

            const nextQty = Math.min(20, curQty + 1);
            if (window.ghUpdateVariantQuantity) {
              window.ghUpdateVariantQuantity(variantId, nextQty, curQty === 0);
            }
          });
        }

        // 2. PLUS (+)
        if (plusBtn) {
          plusBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!variantId) return;
            if (qtyBox && qtyBox.classList.contains('is-locked')) return;

            let cur = parseInt(qtyVal ? qtyVal.textContent : '1', 10) || 1;
            if (cur >= 20) return; // Disallow exceeding 20

            const nextQty = Math.min(20, cur + 1);
            if (window.ghUpdateVariantQuantity) {
              window.ghUpdateVariantQuantity(variantId, nextQty, false);
            }
          });
        }

        // 3. MINUS (-)
        if (minusBtn) {
          minusBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (!variantId) return;
            if (qtyBox && qtyBox.classList.contains('is-locked')) return;

            let cur = parseInt(qtyVal ? qtyVal.textContent : '1', 10) || 1;
            const nextQty = Math.max(0, cur - 1);

            if (window.ghUpdateVariantQuantity) {
              window.ghUpdateVariantQuantity(variantId, nextQty, false);
            }
          });
        }
      });
      if (window.GhorerWishlist) {
        window.GhorerWishlist.syncUI();
      }
    };

    // Listen to global cart:updated events so cards always sync when cart changes from any source
    document.addEventListener('cart:updated', function(e) {
      if (e && e.detail && e.detail.cart) {
        if (window.syncAllProductCards) window.syncAllProductCards(e.detail.cart);
      } else if (window.syncAllProductCards) {
        window.syncAllProductCards();
      }
    });

    // Auto-init on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        window.initGhProductCards();
        if (window.syncAllProductCards) window.syncAllProductCards();
      });
    } else {
      window.initGhProductCards();
      if (window.syncAllProductCards) window.syncAllProductCards();
    }
  } else {
    if (typeof window.initGhProductCards === 'function') {
      window.initGhProductCards();
    }
  }
</script>